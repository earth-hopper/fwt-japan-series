---
// src/components/Footer.astro

interface PartnerItem {
  name: string;
  href: string;
  logo: string;
  heightClass: string;
}

interface PartnerGroup {
  tier: string;
  partners: PartnerItem[];
  containerClass: string;
}

const partnerGroups: PartnerGroup[] = [
  {
    tier: 'Title Partner',
    containerClass: 'flex items-center justify-center gap-8 md:gap-12',
    partners: [
      {
        name: 'TOYO TIRES',
        href: 'https://www.toyotires.co.jp/',
        logo: '/img/logo_toyo.webp',
        heightClass: 'h-20 md:h-24',
      },
    ],
  },
  {
    tier: 'Main Sponsors',
    containerClass: 'flex flex-wrap md:flex-nowrap items-center justify-center gap-8 md:gap-16',
    partners: [
      {
        name: 'MAMMUT',
        href: 'https://www.mammut.jp/',
        logo: '/img/logo_mammut.webp',
        heightClass: 'h-10 md:h-12',
      },
      {
        name: 'Earthhopper',
        href: 'https://www.hopper.earth/',
        logo: '/img/logo_eh.webp',
        heightClass: 'h-10 md:h-12',
      },
    ],
  },
  {
    tier: 'Destination Partners',
    containerClass: 'flex flex-wrap md:flex-nowrap items-center justify-center gap-6 md:gap-12',
    partners: [
      {
        name: 'Hakuba Valley',
        href: 'https://www.hakubavalley.com/',
        logo: '/img/logo_hakuba.webp',
        heightClass: 'h-9 md:h-11',
      },
      {
        name: '湯沢中里スノーリゾート',
        href: 'https://www.yuzawa-nakazato.com/winter/',
        logo: '/img/logo_nakazato.webp',
        heightClass: 'h-9 md:h-11',
      },
      {
        name: 'アライマウンテンリゾート',
        href: 'https://www.lottehotel.com/arai-resort/ja/snow-season',
        logo: '/img/logo_arai.webp',
        heightClass: 'h-9 md:h-11',
      },
    ],
  },
  {
    tier: 'Special Supporter',
    containerClass: 'flex items-center justify-center gap-8 md:gap-12',
    partners: [
      {
        name: 'YETI',
        href: 'https://yeti.co.jp/',
        logo: '/img/logo_yeti.webp',
        heightClass: 'h-10 md:h-12',
      },
    ],
  },
];

const navLinks = [
  { label: 'FWTとは', href: '/about' },
  { label: '大会日程', href: '/series' },
  { label: 'ランキング', href: '/rankings' },
  { label: 'ライダー', href: '/riders' },
  { label: 'リプレイ', href: '/replay' },
  { label: 'ニュース', href: '/news' },
];

const legalLinks = [
  { label: '運営団体', href: '/team.html' },
  { label: '利用規約', href: '/policy.html' },
  { label: 'お問い合わせ', href: 'https://forms.gle/iWdSzx2iMYZziy9X8', target: '_blank' },
];

const tickerText = 'FWT JAPAN SERIES // FREERIDE WORLD TOUR // DROP IN // JUST SEND IT // HAKUBA TO NISEKO // JAPOW // LINE // FLUIDITY // CONTROL // AIR & STYLE // TECHNIQUE // MOUNTAIN // ZONE //';
---

<!-- パートナーセクション -->
<section class="bg-slate-50 py-14 md:py-20 border-y border-slate-200 fwt-partners-component" aria-labelledby="partners-heading">
  <div class="max-w-5xl mx-auto px-6 md:px-12">
    <div class="text-center mb-10 md:mb-12">
      <h2 id="partners-heading" class="font-extreme text-2xl md:text-3xl font-black text-slate-900 uppercase tracking-wider">
        2026 PARTNERS
      </h2>
    </div>

    <div class="space-y-10 md:space-y-12">
      {partnerGroups.map((group) => (
        <div>
          <div class="flex items-center gap-4 mb-6" role="presentation">
            <div class="h-px flex-1 bg-slate-300"></div>
            <span class="font-extreme text-xs font-extrabold text-slate-500 tracking-[0.2em] uppercase whitespace-nowrap">
              {group.tier}
            </span>
            <div class="h-px flex-1 bg-slate-300"></div>
          </div>
          <div class={group.containerClass}>
            {group.partners.map((partner) => (
              <a
                href={partner.href}
                target="_blank"
                rel="noopener noreferrer"
                class="block px-4 py-2 hover:opacity-80 transition duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded"
                aria-label={`${partner.name}（新規タブで開く）`}
              >
                <img
                  loading="lazy"
                  decoding="async"
                  src={partner.logo}
                  alt={partner.name}
                  class={`${partner.heightClass} w-auto object-contain`}
                />
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- パートナー募集セクション -->
<section class="relative bg-slate-950 text-white py-20 md:py-28 overflow-hidden border-t border-slate-800" aria-labelledby="partner-recruit-heading">
  <!-- アンビエント発光背景 -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[600px] h-[300px] bg-red-600/10 blur-[130px] rounded-full"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-slate-900/50 via-slate-950 to-slate-950"></div>
  </div>

  <div class="relative max-w-5xl mx-auto px-6 md:px-12 text-center">
    <!-- ラベルバッジ -->
    <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-red-600/15 border border-red-500/30 text-red-400 text-xs sm:text-sm font-bold tracking-[0.2em] uppercase mb-6">
      <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse" aria-hidden="true"></span>
      Become a Partner
    </div>

    <!-- メイン見出し -->
    <h2 id="partner-recruit-heading" class="text-2xl sm:text-4xl md:text-5xl font-black tracking-tight leading-tight sm:leading-snug text-white max-w-4xl mx-auto">
      世界が熱狂する新五輪競技と共に、<br class="hidden sm:inline" />
      <span class="bg-gradient-to-r from-white via-slate-100 to-slate-300 bg-clip-text text-transparent">ブランドの新たな頂へ。</span>
    </h2>

    <!-- リードテキスト -->
    <p class="mt-6 text-base sm:text-lg md:text-xl text-slate-200 leading-relaxed md:leading-loose max-w-3xl mx-auto font-normal">
      2030年冬季五輪正式種目に決定し、白馬やニセコから熱狂を発信するFWT JAPAN SERIES。国内外の高感度層・富裕層が集うこの急成長プラットフォームは、企業の挑戦姿勢の体現から次世代育成、雪上での実証実験まで多面的な価値を生み出します。新時代のスポーツ・カルチャーを黎明期から共に牽引するパートナー企業様を求めています。
    </p>

    <!-- CTAエリア -->
    <div class="mt-10 flex flex-col items-center justify-center gap-3.5">
      <a
        href="https://forms.gle/c3iMT5ogyu27iVZEA"
        target="_blank"
        rel="noopener noreferrer"
        class="group inline-flex items-center gap-3 px-8 py-4 text-base md:text-lg font-bold tracking-wider text-white bg-red-600 rounded-full hover:bg-red-500 transition-all duration-300 shadow-lg shadow-red-600/30 hover:shadow-red-600/50 hover:-translate-y-0.5 whitespace-nowrap focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-red-500 focus-visible:ring-offset-slate-950"
      >
        <span>パートナーシップのお問い合わせ</span>
        <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
      <span class="text-xs sm:text-sm text-slate-400 font-medium tracking-wide">協賛プラン・個別共創のご相談を随時承っております</span>
    </div>
  </div>
</section>

<!-- 赤帯ティッカー（Zero-JS / SSR完全対応） -->
<div class="fwt-ticker" aria-label="ブランドメッセージティッカー">
  <div class="fwt-ticker-track">
    <span class="fwt-ticker-item font-extreme italic text-sm md:text-base font-black tracking-[0.25em] uppercase">
      {tickerText}
    </span>
    <span class="fwt-ticker-item font-extreme italic text-sm md:text-base font-black tracking-[0.25em] uppercase" aria-hidden="true">
      {tickerText}
    </span>
  </div>
</div>

<!-- メインフッター -->
<footer class="bg-slate-50 border-t border-slate-200 py-12 md:py-16">
  <div class="max-w-7xl mx-auto px-4 md:px-8 flex flex-col lg:flex-row gap-12 lg:gap-16">
    <div class="lg:w-1/3">
      <a href="/" class="inline-block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded">
        <img loading="lazy" decoding="async" src="/img/logo.webp" alt="FWT JAPAN SERIES" class="h-[34px] w-auto object-contain" />
      </a>
      <p class="mt-4 text-[15px] text-slate-700 leading-relaxed max-w-sm">
        自然のままの地形を滑り、テクニックとスタイルを競うフリーライドの世界一を決めるツアー。
      </p>
      <div class="mt-6 flex items-center gap-5">
        <a
          href="https://www.youtube.com/@FreerideWorldTourJapan"
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-500 hover:text-red-600 transition-colors text-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded"
          aria-label="FWT 公式 YouTube（新規タブで開く）"
        >
          <i class="ri-youtube-fill" aria-hidden="true"></i>
        </a>
        <a
          href="https://x.com/fwt_japan"
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-500 hover:text-red-600 transition-colors text-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded"
          aria-label="FWT 公式 X（新規タブで開く）"
        >
          <i class="ri-twitter-line" aria-hidden="true"></i>
        </a>
        <a
          href="https://www.instagram.com/freerideworldtour_jp/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-500 hover:text-red-600 transition-colors text-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded"
          aria-label="FWT 公式 Instagram（新規タブで開く）"
        >
          <i class="ri-instagram-line" aria-hidden="true"></i>
        </a>
      </div>
    </div>

    <!-- 主要ナビゲーション -->
    <nav class="lg:w-2/3 grid grid-cols-2 sm:grid-cols-3 gap-x-8 gap-y-5" aria-label="フッターナビゲーション">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="text-sm md:text-[15px] tracking-wider uppercase font-semibold text-slate-700 hover:text-red-600 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded inline-block w-fit py-0.5"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>

  <div class="max-w-7xl mx-auto px-4 md:px-8 mt-12 pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs md:text-sm font-medium tracking-wide text-slate-600">
    <p>&copy; FWT JAPAN SERIES. All rights reserved.</p>
    <nav class="flex items-center gap-6" aria-label="法的情報・運営方針">
      {legalLinks.map((link) => (
        <a
          href={link.href}
          target={link.target}
          class="hover:text-slate-900 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</footer>

<style>
  .fwt-ticker {
    width: 100%;
    overflow: hidden;
    background: #e20000;
    padding: 16px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.3);
    border-bottom: 1px solid rgba(255, 255, 255, 0.3);
  }

  .fwt-ticker-track {
    display: flex;
    flex-wrap: nowrap;
    width: max-content;
    will-change: transform;
    animation: fwt-marquee 30s linear infinite;
  }

  .fwt-ticker-item {
    white-space: nowrap;
    display: inline-block;
    color: #ffffff;
    padding-right: 2.5rem;
  }

  @keyframes fwt-marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .fwt-ticker:hover .fwt-ticker-track {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .fwt-ticker-track {
      animation: none;
    }
    .fwt-ticker {
      overflow-x: auto;
    }
  }
</style>