---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

const pageTitle = "ニュース";
const pageDescription = "FWT JAPAN SERIESの最新情報をお届け。大会の開催告知やリザルト速報、エントリー案内、フリーライドスキー・スノーボードシーンの最新トピックスや普及イベントの情報を発信しています。";
const ogImage = "/img/news.webp";

// ニュース一覧を取得し、日付の新しい順にソート
const allNews: CollectionEntry<'news'>[] = await getCollection('news');
const sortedNews = allNews.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// 重複のないカテゴリリストを生成
const categories = ['ALL', ...new Set(sortedNews.map((n) => n.data.category))];

// スラッグ解決関数（Content Layer API では entry.slug ではなく entry.id に格納されるため両対応）
const getNewsSlug = (entry: CollectionEntry<'news'>): string => {
  const rawId = entry.id ?? (entry as Record<string, unknown>).slug ?? '';
  return String(rawId).replace(/\.(md|mdx)$/, '');
};

// 日付フォーマット (YYYY.MM.DD)
const formatDate = (date: Date): string => {
  const y = date.getFullYear();
  const m = String(date.getMonth() + 1).padStart(2, '0');
  const d = String(date.getDate()).padStart(2, '0');
  return `${y}.${m}.${d}`;
};

// サイトURLと絶対URLの組み立て
const siteUrl = Astro.site?.toString() ?? "https://freerideworldtour.jp";
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();

// ページ固有の構造化データ（Schema.org: CollectionPage + BreadcrumbList）
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": pageTitle,
    "description": pageDescription,
    "url": pageUrl,
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": sortedNews.length,
      "itemListElement": sortedNews.slice(0, 15).map((item, index) => ({
        "@type": "ListItem",
        "position": index + 1,
        "url": new URL(`/news/${getNewsSlug(item)}/`, siteUrl).toString(),
        "name": item.data.title
      }))
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "HOME",
        "item": "/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": pageTitle,
        "item": pageUrl
      }
    ]
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={ogImage}
  type="website"
  schema={schema}
>
  <!-- ヒーローセクション（ブランド統一デザイン・LCP最適化） -->
  <header class="relative w-full h-[280px] sm:h-[320px] md:h-[400px] overflow-hidden flex items-center justify-center text-center px-4">
    <div class="absolute inset-0">
      <img
        src={ogImage}
        alt="FWT JAPAN SERIES ニュース＆最新トピックス"
        class="w-full h-full object-cover scale-105 transform-gpu"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        width="1920"
        height="800"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/45 to-slate-950/90" aria-hidden="true"></div>
    </div>
    
    <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center">
      <span class="inline-block text-xs sm:text-sm font-black tracking-widest text-red-500 uppercase mb-3 px-3 py-1 bg-black/60 border border-red-500/30 rounded-full backdrop-blur-sm">
        News & Topics
      </span>
      <h1 class="font-extreme text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black text-white tracking-tighter uppercase m-0 leading-none drop-shadow-2xl">
        NEWS
      </h1>
      <p class="mt-3 text-sm sm:text-base md:text-lg font-bold text-slate-200 tracking-wider">
        最新情報・大会速報
      </p>
    </div>
  </header>

  <!-- パンくずリストナビゲーション -->
  <nav aria-label="パンくずリスト" class="border-b border-slate-200 bg-slate-50/90">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-16 py-3">
      <ol class="flex items-center space-x-2 text-xs sm:text-sm text-slate-600">
        <li>
          <a
            href="/"
            class="hover:text-red-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded px-1 py-0.5 transition-colors"
          >
            HOME
          </a>
        </li>
        <li aria-hidden="true" class="text-slate-400 select-none">/</li>
        <li class="font-semibold text-slate-900 truncate" aria-current="page">
          {pageTitle}
        </li>
      </ol>
    </div>
  </nav>

  <!-- ニュースメインセクション -->
  <main class="relative bg-white pt-10 md:pt-16 pb-24 md:pb-32 overflow-hidden border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-16">

      <!-- カテゴリ切り替えボタン -->
      <section aria-label="カテゴリー絞り込み" class="mb-12 md:mb-16">
        <div id="category-buttons" role="group" class="flex flex-wrap gap-2.5 sm:gap-3">
          {categories.map((cat) => (
            <button
              type="button"
              data-category={cat}
              aria-pressed={cat === 'ALL' ? 'true' : 'false'}
              class="cat-btn px-4 sm:px-5 py-2 sm:py-2.5 text-[11px] sm:text-xs font-bold tracking-[0.1em] uppercase border rounded-full transition-all duration-200 outline-none
                     bg-white text-slate-600 border-slate-200 hover:border-slate-400 hover:text-slate-900
                     aria-pressed:bg-slate-900 aria-pressed:text-white aria-pressed:border-slate-900 aria-pressed:shadow-md
                     focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2"
            >
              {cat}
            </button>
          ))}
        </div>
      </section>

      <!-- ニュースリスト（カード型を排除したソリッドな3カラムエディトリアルグリッド） -->
      <ul id="news-list" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-8 gap-y-14 md:gap-y-20 list-none p-0 m-0">
        {sortedNews.map((item) => {
          const slug = getNewsSlug(item);
          return (
            <li data-news-category={item.data.category} class="news-item flex flex-col">
              <article class="w-full flex-grow flex flex-col">
                <a 
                  href={`/news/${slug}/`} 
                  class="group flex flex-col h-full focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-4"
                >
                  <!-- サムネイル写真（直角・シャドウなし・アスペクト比固定） -->
                  <figure class="relative aspect-[16/10] overflow-hidden bg-slate-100 mb-5 m-0">
                    <img 
                      src={item.data.thumbnail} 
                      alt="" 
                      loading="lazy" 
                      decoding="async"
                      width="640"
                      height="400"
                      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105" 
                    />
                    <!-- 直角のソリッドバッジ -->
                    <div class="absolute top-3 left-3 bg-slate-900 text-white font-mono text-[9px] font-bold px-2.5 py-1 tracking-widest uppercase">
                      {item.data.category}
                    </div>
                  </figure>
                  
                  <!-- 日付・メタ情報 -->
                  <div class="flex items-center justify-between pb-2 mb-3 border-b border-slate-200">
                    <time datetime={item.data.date.toISOString()} class="font-mono text-xs text-slate-400 font-bold tracking-widest">
                      {formatDate(item.data.date)}
                    </time>
                    <svg
                      class="w-4 h-4 text-slate-300 group-hover:text-red-600 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-200"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <line x1="7" y1="17" x2="17" y2="7"></line>
                      <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                  </div>

                  <!-- 記事タイトル -->
                  <h2 class="font-extreme text-lg sm:text-xl font-black text-slate-900 uppercase group-hover:text-red-600 transition-colors leading-snug line-clamp-2 mb-2.5 m-0">
                    {item.data.title}
                  </h2>

                  <!-- 記事抜粋 -->
                  {item.data.excerpt && (
                    <p class="text-slate-500 text-xs sm:text-sm leading-relaxed line-clamp-3 font-medium m-0 mt-auto">
                      {item.data.excerpt}
                    </p>
                  )}
                </a>
              </article>
            </li>
          );
        })}
      </ul>

      <!-- 該当なし表示 -->
      <div 
        id="no-news-message" 
        role="status" 
        aria-live="polite" 
        class="hidden py-16 text-center border-b border-slate-200 bg-slate-50/50 font-medium text-slate-500 mt-6"
      >
        該当するニュースがありません。
      </div>
      
    </div>
  </main>
</Layout>

<script>
  function setupNewsFilter() {
    const container = document.getElementById('category-buttons');
    const items = document.querySelectorAll<HTMLElement>('.news-item');
    const noNewsMsg = document.getElementById('no-news-message');

    if (!container || items.length === 0) return;

    const buttons = container.querySelectorAll<HTMLButtonElement>('.cat-btn');

    function switchCategory(targetCategory: string) {
      const newUrl = new URL(window.location.href);
      if (targetCategory === 'ALL') {
        newUrl.searchParams.delete('category');
      } else {
        newUrl.searchParams.set('category', targetCategory);
      }
      window.history.replaceState({}, '', newUrl);

      // ARIA 属性を更新（Tailwind の aria-pressed バリアントでスタイル連動）
      buttons.forEach((btn) => {
        const isActive = btn.dataset.category === targetCategory;
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });

      let visibleCount = 0;
      items.forEach((item) => {
        const isMatch = targetCategory === 'ALL' || item.dataset.newsCategory === targetCategory;
        item.classList.toggle('hidden', !isMatch);
        if (isMatch) visibleCount++;
      });

      if (noNewsMsg) {
        noNewsMsg.classList.toggle('hidden', visibleCount > 0);
      }
    }

    // 初期化（URLクエリパラメータの解決）
    const urlParams = new URLSearchParams(window.location.search);
    const initialCategory = urlParams.get('category') || 'ALL';
    switchCategory(initialCategory);

    // イベント委譲によるクリックハンドリング
    container.onclick = (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.cat-btn');
      if (btn && btn.dataset.category) {
        switchCategory(btn.dataset.category);
      }
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupNewsFilter);
  } else {
    setupNewsFilter();
  }
  document.addEventListener('astro:page-load', setupNewsFilter);
</script>