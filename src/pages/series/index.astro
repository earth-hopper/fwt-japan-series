---
import Layout from '../../layouts/Layout.astro';
import rawEvents from '../../data/events.json';

interface RawEvent {
  id: string;
  name: string;
  area: string;
  category: string;
  stars: number;
  schedule: {
    start_date: string;
    end_date: string;
  };
}

interface EventItem {
  id: string;
  title: string;
  venue: string;
  category: string;
  grade: string;
  stars: number;
  link: string;
  startDate: string;
  endDate: string;
  dateText: string;
  imagePath: string;
}

const pageTitle = "大会日程";
const pageDescription = "FWT JAPAN SERIESの年間ツアースケジュール一覧。白馬をはじめとする各開催地の大会日程、エントリー期間、競技種目（スキー・スノーボード）、会場アクセス、当日のタイムスケジュール情報を掲載しています。";
const ogImage = "/img/series/hero.webp";

// サイトURLと絶対URLの組み立て
const siteUrl = Astro.site?.toString() ?? "https://freerideworldtour.jp";
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();

// 日付フォーマット関数: "2027-01-25", "2027-01-28" -> "2027.1.25 - 1.28"
function formatDateRange(startDateStr: string, endDateStr: string): string {
  const [sY, sM, sD] = startDateStr.split('-').map(Number);
  const [eY, eM, eD] = endDateStr.split('-').map(Number);

  return sY === eY
    ? `${sY}.${sM}.${sD} - ${eM}.${eD}`
    : `${sY}.${sM}.${sD} - ${eY}.${eM}.${eD}`;
}

const eventsData = (rawEvents as RawEvent[]) || [];

// データの整形と開始日昇順ソート
const sortedEvents: EventItem[] = eventsData
  .map((event) => ({
    id: event.id,
    title: event.name,
    venue: event.area,
    category: event.category,
    grade: '★'.repeat(event.stars),
    stars: event.stars,
    link: `/series/${event.id}/`,
    startDate: event.schedule.start_date,
    endDate: event.schedule.end_date,
    dateText: formatDateRange(event.schedule.start_date, event.schedule.end_date),
    imagePath: `/img/series/${event.area.toLowerCase()}.webp`,
  }))
  .sort((a, b) => a.startDate.localeCompare(b.startDate));

// カテゴリーごとのグルーピング
const seriesCategories = [
  {
    title: 'QUALIFIER SERIES',
    subtitle: 'FWT QUALIFIER',
    events: sortedEvents.filter((e) => e.category === 'FREERIDE WORLD TOUR QUALIFIER'),
  },
  {
    title: 'JUNIOR SERIES',
    subtitle: 'FWT JUNIOR',
    events: sortedEvents.filter((e) => e.category === 'FREERIDE WORLD TOUR JUNIOR'),
  },
];

// --- 構造化データ（SportsEvent 配列 + BreadcrumbList） ---
const sportsEventsSchema = sortedEvents.map((event) => ({
  "@context": "https://schema.org",
  "@type": "SportsEvent",
  "name": event.title,
  "startDate": event.startDate,
  "endDate": event.endDate,
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": event.venue,
    "address": {
      "@type": "PostalAddress",
      "addressCountry": "JP"
    }
  },
  "image": [new URL(event.imagePath, siteUrl).toString()],
  "url": new URL(event.link, siteUrl).toString(),
  "description": `FWT JAPAN SERIES ${event.title}（開催地: ${event.venue}）の大会日程およびエントリー情報。`,
  "organizer": {
    "@type": "SportsOrganization",
    "name": "FWT JAPAN SERIES",
    "url": siteUrl
  }
}));

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "HOME",
      "item": "/"
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": pageTitle,
      "item": pageUrl
    }
  ]
};

const schema = [...sportsEventsSchema, breadcrumbSchema];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={ogImage}
  type="website"
  schema={schema}
>
  <!-- ヒーローセクション（ブランド統一デザイン・LCP最適化） -->
  <header class="relative w-full h-[280px] sm:h-[320px] md:h-[400px] overflow-hidden flex items-center justify-center text-center px-4">
    <div class="absolute inset-0">
      <img
        src={ogImage}
        alt="雪山の急斜面で開催されるFWT JAPAN SERIES 大会会場"
        class="w-full h-full object-cover scale-105 transform-gpu"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        width="1920"
        height="800"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/45 to-slate-950/90" aria-hidden="true"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center">
      <span class="inline-block text-xs sm:text-sm font-black tracking-widest text-red-500 uppercase mb-3 px-3 py-1 bg-black/60 border border-red-500/30 rounded-full backdrop-blur-sm">
        Tour Schedule & Events
      </span>
      <h1 class="font-extreme text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black text-white tracking-tighter uppercase m-0 leading-none drop-shadow-2xl">
        EVENTS
      </h1>
      <p class="mt-3 text-sm sm:text-base md:text-lg font-bold text-slate-200 tracking-wider">
        大会日程・ツアースケジュール一覧
      </p>
    </div>
  </header>

  <!-- パンくずリストナビゲーション -->
  <nav aria-label="パンくずリスト" class="border-b border-slate-200 bg-slate-50/90">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-16 py-3">
      <ol class="flex items-center space-x-2 text-xs sm:text-sm text-slate-600">
        <li>
          <a
            href="/"
            class="hover:text-red-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded px-1 py-0.5 transition-colors"
          >
            HOME
          </a>
        </li>
        <li aria-hidden="true" class="text-slate-400 select-none">/</li>
        <li class="font-semibold text-slate-900 truncate" aria-current="page">
          {pageTitle}
        </li>
      </ol>
    </div>
  </nav>

  <!-- エントリー開始告知バー（インラインスタイルを排しアクセシブルに再設計） -->
  <aside aria-label="エントリー受付開始のお知らせ" class="relative w-full bg-red-600 text-white overflow-hidden z-20 border-b border-red-700 shadow-md">
    <div class="absolute inset-0 opacity-10 pointer-events-none bg-[radial-gradient(#fff_1px,transparent_1px)] [background-size:16px_16px]" aria-hidden="true"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-16 py-3.5 md:py-4 relative z-10 flex flex-col md:flex-row items-start md:items-center gap-4 md:gap-6">
      <div class="relative flex items-center justify-center w-10 h-10 shrink-0">
        <div class="absolute inset-0 bg-white rounded-full animate-ping opacity-60 duration-1000" aria-hidden="true"></div>
        <div class="relative z-10 flex items-center justify-center w-8 h-8 bg-white text-red-600 rounded-full shadow-sm">
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 22c1.1 0 2-.9 2-2h-4c0 1.1.9 2 2 2zm6-6v-5c0-3.07-1.63-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.64 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2zm-2 1H8v-6c0-2.48 1.51-4.5 4-4.5s4 2.02 4 4.5v6z"/>
          </svg>
        </div>
      </div>
      <div>
        <div class="font-mono text-[10px] tracking-[0.2em] font-bold mb-1 opacity-90 flex items-center gap-2 uppercase">
          <span class="w-1.5 h-1.5 bg-white inline-block animate-pulse rounded-full" aria-hidden="true"></span>
          2027 FWT Japan Series <span class="hidden md:inline">// Registration Info</span>
        </div>
        <div class="flex flex-col md:flex-row md:items-end gap-1.5 md:gap-5">
          <h2 class="text-lg sm:text-xl md:text-2xl font-black tracking-wide leading-none drop-shadow-sm m-0">
            エントリー受付開始
          </h2>
          <p class="text-xs sm:text-sm md:text-base font-bold tracking-wide text-white m-0">
            2026年11月1日 日本時間20:00 <span class="text-xs font-normal opacity-90 md:ml-1">（スイス時間12:00）</span>
          </p>
        </div>
      </div>
    </div>
  </aside>

  <!-- イベントリスト本体 -->
  <main class="relative bg-white pt-12 md:pt-16 pb-24 md:pb-32 overflow-hidden border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-16">

      <!-- カテゴリーごとに展開（QUALIFIER / JUNIOR） -->
      {seriesCategories.map((category) => (
        <section aria-labelledby={`heading-${category.title.toLowerCase().replace(/\s+/g, '-')}`} class="mb-20 md:mb-28">
          <div class="flex items-end justify-between border-b-2 border-slate-900 pb-4 mb-6">
            <div>
              <span class="font-mono text-[10px] sm:text-xs font-bold text-red-600 tracking-[0.25em] uppercase block mb-1">
                {category.subtitle}
              </span>
              <h2
                id={`heading-${category.title.toLowerCase().replace(/\s+/g, '-')}`}
                class="font-extreme text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight uppercase leading-none m-0"
              >
                {category.title}
              </h2>
            </div>
            <span class="font-mono text-xs md:text-sm text-slate-400 font-bold">
              {category.events.length} EVENTS
            </span>
          </div>

          <ul class="divide-y divide-slate-200 border-b border-slate-200 list-none p-0 m-0">
            {category.events.map((event) => (
              <li>
                <article>
                  <a
                    href={event.link}
                    class="group flex flex-col sm:flex-row items-stretch transition-colors duration-200 hover:bg-slate-50 relative overflow-hidden focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-inset"
                  >
                    <!-- 会場画像 -->
                    <div class="w-full sm:w-60 md:w-72 aspect-[16/10] sm:aspect-auto flex-shrink-0 overflow-hidden relative border-b sm:border-b-0 sm:border-r border-slate-100 bg-slate-100">
                      <img 
                        src={event.imagePath} 
                        alt={`${event.venue}の大会ロケーション`} 
                        class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                        loading="lazy"
                        decoding="async"
                        width="480"
                        height="300"
                      />
                    </div>

                    <!-- イベント詳細 -->
                    <div class="flex-1 p-5 md:p-8 flex flex-col justify-center">
                      <div class="flex flex-wrap items-center gap-2.5 mb-3">
                        <span class="inline-flex items-center gap-1.5 text-[10px] md:text-xs font-bold text-slate-700 bg-slate-100 px-2.5 py-1 rounded border border-slate-200 uppercase tracking-wider">
                          <svg class="w-3.5 h-3.5 text-slate-500 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                          </svg>
                          <span>{event.venue}</span>
                        </span>
                        <span class="text-[10px] md:text-xs font-bold text-red-600 bg-red-50 px-2.5 py-1 rounded border border-red-200 tracking-widest" aria-label={`グレード: 星${event.stars}つ`}>
                          {event.grade}
                        </span>
                      </div>
                      
                      <h3 class="font-extreme text-lg sm:text-xl md:text-2xl font-black text-slate-900 uppercase group-hover:text-red-600 transition-colors leading-snug mb-3 m-0">
                        {event.title}
                      </h3>

                      <div class="flex items-center gap-2 font-mono text-xs sm:text-sm font-semibold text-slate-500 tracking-wider">
                        <svg class="w-4 h-4 text-red-600 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zm0-12H5V6h14v2z"/>
                        </svg>
                        <time datetime={`${event.startDate}/${event.endDate}`}>{event.dateText}</time>
                      </div>
                    </div>

                    <!-- 矢印アイコン -->
                    <div class="hidden sm:flex items-center justify-center px-6 md:px-8 text-slate-300 group-hover:text-red-600 group-hover:translate-x-1 transition-all duration-300 flex-shrink-0" aria-hidden="true">
                      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                      </svg>
                    </div>
                  </a>
                </article>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <!-- 過去の大会を見るボタン -->
      <nav aria-label="アーカイブナビゲーション" class="mt-8 md:mt-16 flex justify-center">
        <a
          href="/series/archive/"
          class="group relative inline-flex items-center gap-3.5 px-8 sm:px-10 py-4 sm:py-4.5 bg-slate-900 text-white overflow-hidden rounded-full transition-transform duration-300 hover:-translate-y-1 hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2"
        >
          <div class="absolute inset-0 bg-red-600 translate-y-full group-hover:translate-y-0 transition-transform duration-300 ease-in-out" aria-hidden="true"></div>
          <span class="relative font-bold text-xs sm:text-sm tracking-[0.2em] uppercase z-10">過去の大会を見る</span>
          <svg class="w-4 h-4 relative z-10 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0 0 13 21a9 9 0 0 0 0-18zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"/>
          </svg>
        </a>
      </nav>
      
    </div>
  </main>
</Layout>