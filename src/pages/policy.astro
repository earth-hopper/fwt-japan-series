---
import Layout from '../layouts/Layout.astro';

const pageTitle = "利用規約・プライバシーポリシー";
const pageDescription = "FWT JAPAN SERIES公式ウェブサイトの利用規約およびプライバシーポリシーです。当サイトのご利用条件、著作権・知的財産権の取り扱い、個人情報の収集・管理、免責事項について定めています。";
const ogImage = "/img/about_hero.webp";

const siteUrl = Astro.site?.toString() ?? "https://freerideworldtour.jp";
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();

// ページ固有の構造化データ（Schema.org: WebPage + BreadcrumbList）
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "name": pageTitle,
    "description": pageDescription,
    "url": pageUrl
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "HOME",
        "item": "/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": pageTitle,
        "item": pageUrl
      }
    ]
  }
];
---

<Layout 
  title={pageTitle}
  description={pageDescription}
  image={ogImage}
  type="website"
  schema={schema}
>
  <!-- ヒーローセクション（ブランド統一デザイン・LCP最適化） -->
  <header class="relative w-full h-[280px] sm:h-[320px] md:h-[400px] overflow-hidden flex items-center justify-center text-center px-4">
    <div class="absolute inset-0">
      <img
        src={ogImage}
        alt="雪山の急斜面をダイナミックに滑走するフリーライド競技の様子"
        class="w-full h-full object-cover scale-105 transform-gpu"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        width="1920"
        height="800"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/45 to-slate-950/90" aria-hidden="true"></div>
    </div>
    
    <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center">
      <span class="inline-block text-xs sm:text-sm font-black tracking-widest text-red-500 uppercase mb-3 px-3 py-1 bg-black/60 border border-red-500/30 rounded-full backdrop-blur-sm">
        Legal & Compliance
      </span>
      <h1 class="font-extreme text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black text-white tracking-tighter uppercase m-0 leading-none drop-shadow-2xl">
        TERMS & PRIVACY
      </h1>
      <p class="mt-3 text-sm sm:text-base md:text-lg font-bold text-slate-200 tracking-wider">
        利用規約およびプライバシーポリシー
      </p>
    </div>
  </header>

  <!-- パンくずリストナビゲーション -->
  <nav aria-label="パンくずリスト" class="border-b border-slate-200 bg-slate-50/90">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 md:px-8 py-3">
      <ol class="flex items-center space-x-2 text-xs sm:text-sm text-slate-600">
        <li>
          <a
            href="/"
            class="hover:text-red-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded px-1 py-0.5 transition-colors"
          >
            HOME
          </a>
        </li>
        <li aria-hidden="true" class="text-slate-400 select-none">/</li>
        <li class="font-semibold text-slate-900 truncate" aria-current="page">
          {pageTitle}
        </li>
      </ol>
    </div>
  </nav>

  <!-- ドキュメント本文 -->
  <main class="bg-white py-14 sm:py-20 md:py-28 border-b border-slate-200">
    <article class="max-w-4xl mx-auto px-4 sm:px-6 md:px-8 text-slate-700 leading-relaxed font-sans">
      
      <!-- ページヘッダー -->
      <header class="mb-14 sm:mb-20 text-center border-b-2 border-slate-900 pb-8 sm:pb-12">
        <span class="font-mono text-xs sm:text-sm font-bold text-red-600 tracking-[0.25em] uppercase block mb-2">
          Terms of Use & Privacy Policy
        </span>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-slate-900 tracking-tight m-0">
          利用規約およびプライバシーポリシー
        </h2>
      </header>

      <!-- 1. 利用規約 -->
      <section aria-labelledby="heading-terms" class="mb-20 sm:mb-24">
        <div class="flex items-center gap-3 mb-8 sm:mb-12 border-b border-slate-200 pb-4">
          <span class="w-2.5 h-2.5 bg-red-600 shrink-0" aria-hidden="true"></span>
          <h3 id="heading-terms" class="font-extreme text-2xl sm:text-3xl md:text-4xl font-black text-slate-900 tracking-tight uppercase m-0 leading-none">
            利用規約
          </h3>
        </div>
        
        <div class="space-y-12 sm:space-y-16">
          <section aria-labelledby="terms-sec-1">
            <h4 id="terms-sec-1" class="text-base sm:text-lg font-black text-slate-900 mb-3 border-l-4 border-red-600 pl-4 tracking-wide m-0">
              1. 本規約について
            </h4>
            <div class="pl-5 text-sm sm:text-base text-slate-600 leading-loose">
              <p class="m-0">
                本利用規約（以下「本規約」）は、FWT JAPAN（以下「当団体」）が運営する「FWT JAPAN SERIES」公式ウェブサイト（以下「本サイト」）および当団体が運営する各ソーシャルメディアの利用条件を定めるものです。利用者は、本サイトを閲覧または利用することで、本規約に同意したものとみなされます。
              </p>
            </div>
          </section>

          <section aria-labelledby="terms-sec-2">
            <h4 id="terms-sec-2" class="text-base sm:text-lg font-black text-slate-900 mb-3 border-l-4 border-red-600 pl-4 tracking-wide m-0">
              2. 知的財産権の帰属
            </h4>
            <div class="pl-5 text-sm sm:text-base text-slate-600 leading-loose space-y-3">
              <p class="m-0">
                <strong class="text-slate-900 font-bold">当団体の権利：</strong> 
                本サイトに掲載されている動画、写真、画像、文章、デザイン、構造、プログラム等に関する著作権その他の知的財産権は、原則として当団体に帰属します。
              </p>
              <p class="m-0">
                <strong class="text-slate-900 font-bold">ライセンスブランド：</strong> 
                本サイト上で使用される「Freeride World Tour」の名称およびロゴは、FWT Management SAが所有する知的財産であり、当団体は適正なライセンスに基づきこれらを使用しています。
              </p>
              <p class="m-0">
                <strong class="text-slate-900 font-bold">禁止事項：</strong> 
                法令により認められる場合を除き、当団体の事前の書面による許可なく、本サイトのコンテンツを複製、転用、販売、公衆送信等することは固く禁じられています。
              </p>
            </div>
          </section>

          <section aria-labelledby="terms-sec-3">
            <h4 id="terms-sec-3" class="text-base sm:text-lg font-black text-slate-900 mb-3 border-l-4 border-red-600 pl-4 tracking-wide m-0">
              3. 禁止事項
            </h4>
            <div class="pl-5 text-sm sm:text-base text-slate-600 leading-loose space-y-3">
              <p class="m-0">利用者は、本サイトの利用にあたり、以下の行為を行ってはなりません。</p>
              <ul class="list-disc pl-5 space-y-2 marker:text-red-600 m-0">
                <li>当団体または第三者の知的財産権、プライバシー、名誉、その他の権利を侵害する行為。</li>
                <li>本サイトの運営を妨げる行為、または不正アクセスやスクレイピング等の自動プログラムを用いてデータを収集する行為。</li>
                <li>本サイトのセキュリティを脅かす行為、または有害なプログラム（ウィルス等）を送信・配布する行為。</li>
                <li>法令または公序良俗に反する行為。</li>
              </ul>
            </div>
          </section>

          <section aria-labelledby="terms-sec-4">
            <h4 id="terms-sec-4" class="text-base sm:text-lg font-black text-slate-900 mb-3 border-l-4 border-red-600 pl-4 tracking-wide m-0">
              4. 免責事項
            </h4>
            <div class="pl-5 text-sm sm:text-base text-slate-600 leading-loose space-y-3">
              <p class="m-0">
                当団体は、本サイトに掲載される情報の正確性、完全性、有用性、またはコンピュータウィルス等の有害要素が含まれていないことについて、明示的か黙示的かを問わずいかなる保証も行いません。
              </p>
              <p class="m-0">
                利用者が本サイトを利用したこと、または利用できなかったことによって生じた損害（直接的、間接的、付随的損害、利益の損失等を含む）について、当団体は一切の責任を負わないものとします。
              </p>
            </div>
          </section>

          <section aria-labelledby="terms-sec-5">
            <h4 id="terms-sec-5" class="text-base sm:text-lg font-black text-slate-900 mb-3 border-l-4 border-red-600 pl-4 tracking-wide m-0">
              5. その他
            </h4>
            <div class="pl-5 text-sm sm:text-base text-slate-600 leading-loose space-y-3">
              <p class="m-0">
                <strong class="text-slate-900 font-bold">規約の変更：</strong> 
                当団体は、自らの裁量により、いつでも本規約の内容を変更することができるものとします。変更後の規約は本サイトに掲載された時点で効力を生じます。
              </p>
              <p class="m-0">
                <strong class="text-slate-900 font-bold">準拠法・裁判管轄：</strong> 
                本規約は日本法に基づき解釈されます。本サイトの利用に関して生じた一切の紛争については、当団体の所在地を管轄する裁判所を第一審の専属的合意管轄裁判所とします。
              </p>
            </div>
          </section>
        </div>
      </section>

      <!-- 2. プライバシーポリシー -->
      <section aria-labelledby="heading-privacy" class="mb-16 sm:mb-20">
        <div class="flex items-center gap-3 mb-8 sm:mb-12 border-b border-slate-200 pb-4">
          <span class="w-2.5 h-2.5 bg-red-600 shrink-0" aria-hidden="true"></span>
          <h3 id="heading-privacy" class="font-extreme text-2xl sm:text-3xl md:text-4xl font-black text-slate-900 tracking-tight uppercase m-0 leading-none">
            プライバシーポリシー
          </h3>
        </div>
        
        <div class="space-y-12 sm:space-y-16">
          <section aria-labelledby="privacy-sec-1">
            <h4 id="privacy-sec-1" class="text-base sm:text-lg font-black text-slate-900 mb-3 border-l-4 border-red-600 pl-4 tracking-wide m-0">
              1. はじめに
            </h4>
            <div class="pl-5 text-sm sm:text-base text-slate-600 leading-loose">
              <p class="m-0">
                本プライバシーポリシー（以下「本ポリシー」）は、FWT JAPAN（以下「当団体」）が運営する「FWT JAPAN SERIES」公式ウェブサイト（以下「本サイト」）および当団体が運営するSNS等における、個人情報の収集、利用、保護の方針を定めるものです。利用者は、本サイトを利用することで、本ポリシーに同意したものとみなされます。
              </p>
            </div>
          </section>

          <section aria-labelledby="privacy-sec-2">
            <h4 id="privacy-sec-2" class="text-base sm:text-lg font-black text-slate-900 mb-3 border-l-4 border-red-600 pl-4 tracking-wide m-0">
              2. 個人情報の管理主体
            </h4>
            <div class="pl-5 text-sm sm:text-base text-slate-600 leading-loose">
              <p class="m-0">
                本サイトを通じて収集される個人情報の管理責任者は当団体となります。当団体は、FWT Management SA（スイス）よりブランドライセンスを受けて活動する独立した組織であり、取得した個人情報は当団体が責任を持って管理いたします。
              </p>
            </div>
          </section>

          <section aria-labelledby="privacy-sec-3">
            <h4 id="privacy-sec-3" class="text-base sm:text-lg font-black text-slate-900 mb-3 border-l-4 border-red-600 pl-4 tracking-wide m-0">
              3. 情報の収集と利用目的
            </h4>
            <div class="pl-5 text-sm sm:text-base text-slate-600 leading-loose space-y-3">
              <p class="m-0">当団体は、以下の目的のために個人情報を収集・利用します。</p>
              <ul class="list-disc pl-5 space-y-2 marker:text-red-600 m-0">
                <li><strong class="text-slate-900 font-bold">自動的に収集される情報（Cookie等）：</strong> サイトの利用状況分析、ユーザー体験の向上、広告効果の測定。</li>
                <li><strong class="text-slate-900 font-bold">利用者が提供する情報：</strong> お問い合わせへの回答、ニュースレターの配信、イベントへのエントリー管理、メディア登録の審査。</li>
                <li><strong class="text-slate-900 font-bold">アスリート情報：</strong> 大会結果の公表、ランキングの作成、競技情報の周知。</li>
              </ul>
            </div>
          </section>

          <section aria-labelledby="privacy-sec-4">
            <h4 id="privacy-sec-4" class="text-base sm:text-lg font-black text-slate-900 mb-3 border-l-4 border-red-600 pl-4 tracking-wide m-0">
              4. 第三者提供および外部サービス
            </h4>
            <div class="pl-5 text-sm sm:text-base text-slate-600 leading-loose space-y-3">
              <p class="m-0">
                当団体は、円滑な運営のために以下の外部サービスを利用する場合があります。各サービスの利用にあたっては、各社のプライバシーポリシーが適用されます。
              </p>
              <ul class="list-disc pl-5 space-y-1.5 marker:text-red-600 m-0">
                <li>Google Analytics（アクセス解析）</li>
                <li>Mailchimp（ニュースレター配信）</li>
                <li>LiveHeats（競技ライセンス・エントリー管理）</li>
                <li>各種SNS（Facebook、Instagram等によるリターゲティング広告）</li>
              </ul>
              <p class="m-0 text-slate-700 font-medium">
                法令に基づく場合を除き、利用者の同意なく個人情報を販売または第三者に開示することはありません。
              </p>
            </div>
          </section>

          <section aria-labelledby="privacy-sec-5">
            <h4 id="privacy-sec-5" class="text-base sm:text-lg font-black text-slate-900 mb-3 border-l-4 border-red-600 pl-4 tracking-wide m-0">
              5. 利用者の権利
            </h4>
            <div class="pl-5 text-sm sm:text-base text-slate-600 leading-loose space-y-3">
              <p class="m-0">利用者は、当団体が保持する自身の個人情報について、以下の権利を有します。</p>
              <ul class="list-disc pl-5 space-y-1.5 marker:text-red-600 m-0">
                <li>個人情報の開示、訂正、または削除の請求。</li>
                <li>個人情報の利用停止または制限の請求。</li>
                <li>ニュースレター等の配信停止（購読解除）。</li>
              </ul>
            </div>
          </section>

          <section aria-labelledby="privacy-sec-6">
            <h4 id="privacy-sec-6" class="text-base sm:text-lg font-black text-slate-900 mb-3 border-l-4 border-red-600 pl-4 tracking-wide m-0">
              6. 情報の保護と安全管理
            </h4>
            <div class="pl-5 text-sm sm:text-base text-slate-600 leading-loose">
              <p class="m-0">
                当団体は、個人情報の漏洩、紛失、改ざんを防ぐため、合理的かつ適切な安全管理措置を講じています。インターネット上のデータ伝送は100%安全であることを保証できるものではありませんが、最大限の注意を払って保護に努めます。
              </p>
            </div>
          </section>

          <section aria-labelledby="privacy-sec-7">
            <h4 id="privacy-sec-7" class="text-base sm:text-lg font-black text-slate-900 mb-3 border-l-4 border-red-600 pl-4 tracking-wide m-0">
              7. お子様の個人情報について
            </h4>
            <div class="pl-5 text-sm sm:text-base text-slate-600 leading-loose">
              <p class="m-0">
                当団体は、13歳未満のお子様から意図的に個人情報を収集することはありません。13歳未満の方が本サイトを通じて情報を提供する場合は、必ず保護者の同意を得るものとします。
              </p>
            </div>
          </section>
        </div>
      </section>

      <!-- 制定日フッター -->
      <footer class="pt-8 border-t border-slate-200 text-xs sm:text-sm font-mono text-slate-400 pl-5">
        <time datetime="2026-05-30">2026年5月30日 制定</time>
      </footer>

    </article>
  </main>
</Layout>