---
import Layout from '../../layouts/Layout.astro';
import rawPoints from '../../data/points.json';
import type { PointsData, PointTier } from '../types/point';

const pageTitle = "POINTS";
const pageDescription = "FWT（フリーライドワールドツアー）QualifierおよびJunior各大会グレード（4★〜1★）における順位別獲得ポイント一覧表。";
const ogImage = "/img/rankings.webp";

// サイトURLと絶対URLの組み立て
const siteUrl = Astro.site?.toString() ?? 'https://freerideworldtour.jp';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();

// 種目の日本語マッピング
const disciplineMap: Record<string, string> = {
  'SKI MEN': 'スキー男子',
  'SKI WOMEN': 'スキー女子',
  'SNOWBOARD MEN': 'スノーボード男子',
  'SNOWBOARD WOMEN': 'スノーボード女子'
};

const categoryMap: Record<string, string> = {
  'QUALIFIER': 'Qualifier',
  'JUNIOR': 'Junior'
};

const getDisciplineName = (disc: string): string => {
  if (!disc) return '';
  return disciplineMap[disc.toUpperCase()] || disc;
};

const pointsData = rawPoints as PointsData;
const disciplines = Object.keys(pointsData);
const categories = ['QUALIFIER', 'JUNIOR'] as const;

// 構造化データ（Schema.org）
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": pageTitle,
    "description": pageDescription,
    "url": pageUrl
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "HOME",
        "item": "/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": pageTitle,
        "item": "/points/"
      }
    ]
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={ogImage}
  type="website"
  schema={schema}
>
  <!-- ヒーローセクション（ツアープラットフォーム統一デザイン） -->
  <header class="relative w-full h-[280px] sm:h-[320px] md:h-[400px] overflow-hidden flex items-center justify-center text-center px-4">
    <div class="absolute inset-0">
      <img
        src={ogImage}
        alt="雪山を滑走するトップフリーライダーの競技シーン"
        class="w-full h-full object-cover scale-105 transform-gpu"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        width="1920"
        height="800"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/45 to-slate-950/90" aria-hidden="true"></div>
    </div>
    
    <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center">
      <span class="inline-block text-xs sm:text-sm font-black tracking-widest text-red-500 uppercase mb-3 px-3 py-1 bg-black/60 border border-red-500/30 rounded-full backdrop-blur-sm">
        Points Scale
      </span>
      <h1 class="font-extreme text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black text-white tracking-tighter uppercase m-0 leading-none drop-shadow-2xl">
        POINTS
      </h1>
      <p class="mt-3 text-sm sm:text-base md:text-lg font-bold text-slate-200 tracking-wider">
        FWT 大会別・順位別 獲得ポイント一覧表
      </p>
    </div>
  </header>

  <!-- パンくずリストナビゲーション -->
  <nav aria-label="パンくずリスト" class="border-b border-slate-200 bg-slate-50/90">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-16 py-3">
      <ol class="flex items-center space-x-2 text-xs sm:text-sm text-slate-600">
        <li>
          <a
            href="/"
            class="hover:text-red-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded px-1 py-0.5 transition-colors"
          >
            HOME
          </a>
        </li>
        <li aria-hidden="true" class="text-slate-400 select-none">/</li>
        <li class="font-semibold text-slate-900 truncate" aria-current="page">
          {pageTitle}
        </li>
      </ol>
    </div>
  </nav>

  <!-- ポイント表本体セクション -->
  <main class="relative bg-white pt-10 md:pt-16 pb-24 md:pb-32 overflow-hidden border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-16">
      
      <!-- フィルターセクション（種目 ＋ 大会区分のデザインをピル型ボタンで統一） -->
      <section aria-label="表示フィルター" class="mb-10 md:mb-12 space-y-6">
        <!-- 1. 種目切り替えタブ -->
        <div>
          <span class="block text-[11px] font-mono font-bold text-slate-400 uppercase tracking-widest mb-2.5">
            #種目
          </span>
          <div id="discipline-buttons" role="tablist" class="flex flex-wrap gap-2 sm:gap-3">
            {disciplines.map((disc, index) => (
              <button
                type="button"
                role="tab"
                id={`tab-disc-${disc.toLowerCase().replace(/\s+/g, '-')}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                data-discipline={disc}
                class="disc-btn px-4 sm:px-5 py-2 sm:py-2.5 text-xs md:text-sm font-bold tracking-wider border rounded-full transition-all duration-200 outline-none
                       bg-white text-slate-600 border-slate-200 hover:border-slate-400 hover:text-slate-900
                       aria-selected:bg-slate-900 aria-selected:text-white aria-selected:border-slate-900 aria-selected:shadow-md
                       focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2"
              >
                {getDisciplineName(disc)}
              </button>
            ))}
          </div>
        </div>

        <!-- 2. 大会カテゴリ切り替え（種目タブと同一仕様） -->
        <div>
          <span class="block text-[11px] font-mono font-bold text-slate-400 uppercase tracking-widest mb-2.5">
            #カテゴリ
          </span>
          <div id="category-buttons" role="tablist" class="flex flex-wrap gap-2 sm:gap-3">
            {categories.map((cat, index) => (
              <button
                type="button"
                role="tab"
                id={`tab-cat-${cat.toLowerCase()}`}
                aria-selected={index === 0 ? 'true' : 'false'}
                data-category={cat}
                class="cat-btn px-4 sm:px-5 py-2 sm:py-2.5 text-xs md:text-sm font-bold tracking-wider border rounded-full transition-all duration-200 outline-none
                       bg-white text-slate-600 border-slate-200 hover:border-slate-400 hover:text-slate-900
                       aria-selected:bg-slate-900 aria-selected:text-white aria-selected:border-slate-900 aria-selected:shadow-md
                       focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2"
              >
                {categoryMap[cat]}
              </button>
            ))}
          </div>
        </div>
      </section>

      <!-- ポイントテーブル本体 -->
      <div class="w-full border-t-2 border-slate-900">
        <!-- テーブルヘッダー -->
        <div class="grid grid-cols-5 border-b border-slate-900 bg-white">
          <div class="px-3 sm:px-6 py-4 font-mono text-[10px] sm:text-xs font-black text-slate-400 tracking-wider uppercase text-left">
            Rank
          </div>
          <div class="px-2 sm:px-6 py-4 font-mono text-[10px] sm:text-xs font-black text-red-600 tracking-wider text-right uppercase">
            4★
          </div>
          <div class="px-2 sm:px-6 py-4 font-mono text-[10px] sm:text-xs font-black text-slate-700 tracking-wider text-right uppercase">
            3★
          </div>
          <div class="px-2 sm:px-6 py-4 font-mono text-[10px] sm:text-xs font-black text-slate-700 tracking-wider text-right uppercase">
            2★
          </div>
          <div class="px-2 sm:px-6 py-4 font-mono text-[10px] sm:text-xs font-black text-slate-700 tracking-wider text-right uppercase">
            1★
          </div>
        </div>

        <!-- 各組み合わせのテーブルパネル（全58位を一括表示） -->
        <div id="points-wrapper">
          {disciplines.map((disc, discIdx) => (
            categories.map((cat, catIdx) => {
              const rows: PointTier[] = pointsData[disc]?.[cat] || [];
              const panelId = `panel-${disc.toLowerCase().replace(/\s+/g, '-')}-${cat.toLowerCase()}`;
              const isDefault = discIdx === 0 && catIdx === 0;

              return (
                <div
                  id={panelId}
                  role="tabpanel"
                  data-table-discipline={disc}
                  data-table-category={cat}
                  class={`points-content divide-y divide-slate-100 bg-white ${isDefault ? '' : 'hidden'}`}
                >
                  <div class="points-rows-container">
                    {rows.map((row) => (
                      <div class="grid grid-cols-5 items-center px-0 py-3.5 sm:py-4 transition-colors hover:bg-slate-50/80">
                        <!-- 順位 -->
                        <div class="px-3 sm:px-6 font-mono text-xs sm:text-base font-black">
                          <span class={
                            row.rank === 1 ? 'text-amber-500' :
                            row.rank === 2 ? 'text-slate-500' :
                            row.rank === 3 ? 'text-amber-700' : 'text-slate-400'
                          }>
                            #{row.rank}
                          </span>
                        </div>
                        
                        <!-- 4スター -->
                        <div class="px-2 sm:px-6 font-mono text-xs sm:text-base font-black text-red-600 text-right">
                          {row.star4.toLocaleString()}
                        </div>
                        
                        <!-- 3スター -->
                        <div class="px-2 sm:px-6 font-mono text-xs sm:text-sm font-bold text-slate-800 text-right">
                          {row.star3.toLocaleString()}
                        </div>
                        
                        <!-- 2スター -->
                        <div class="px-2 sm:px-6 font-mono text-xs sm:text-sm font-semibold text-slate-600 text-right">
                          {row.star2.toLocaleString()}
                        </div>
                        
                        <!-- 1スター -->
                        <div class="px-2 sm:px-6 font-mono text-xs sm:text-sm font-semibold text-slate-500 text-right">
                          {row.star1.toLocaleString()}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              );
            })
          ))}
        </div>
      </div>

    </div>
  </main>
</Layout>

<script>
  function setupPointsTable() {
    const discButtons = document.querySelectorAll<HTMLButtonElement>('.disc-btn');
    const catButtons = document.querySelectorAll<HTMLButtonElement>('.cat-btn');
    const contents = document.querySelectorAll<HTMLElement>('.points-content');

    if (discButtons.length === 0 || catButtons.length === 0) return;

    const urlParams = new URLSearchParams(window.location.search);
    const urlDisc = urlParams.get('discipline');
    const urlCat = urlParams.get('category');
    const storageDisc = sessionStorage.getItem('fwt_selected_discipline');
    const storageCat = sessionStorage.getItem('fwt_selected_category');

    const availableDiscs = Array.from(discButtons).map((b) => b.dataset.discipline);
    const availableCats = Array.from(catButtons).map((b) => b.dataset.category);

    let activeDisc =
      urlDisc && availableDiscs.includes(urlDisc)
        ? urlDisc
        : storageDisc && availableDiscs.includes(storageDisc)
        ? storageDisc
        : availableDiscs[0] || 'SKI MEN';

    let activeCat =
      urlCat && availableCats.includes(urlCat)
        ? urlCat
        : storageCat && availableCats.includes(storageCat)
        ? storageCat
        : availableCats[0] || 'QUALIFIER';

    function updateView() {
      sessionStorage.setItem('fwt_selected_discipline', activeDisc);
      sessionStorage.setItem('fwt_selected_category', activeCat);

      const newUrl = new URL(window.location.href);
      newUrl.searchParams.set('discipline', activeDisc);
      newUrl.searchParams.set('category', activeCat);
      window.history.replaceState({}, '', newUrl);

      // 種目ボタンのARIA更新
      discButtons.forEach((btn) => {
        btn.setAttribute('aria-selected', btn.dataset.discipline === activeDisc ? 'true' : 'false');
      });

      // カテゴリボタンのARIA更新
      catButtons.forEach((btn) => {
        btn.setAttribute('aria-selected', btn.dataset.category === activeCat ? 'true' : 'false');
      });

      // 該当パネルの表示切り替え
      contents.forEach((content) => {
        const isMatch =
          content.dataset.tableDiscipline === activeDisc &&
          content.dataset.tableCategory === activeCat;
        content.classList.toggle('hidden', !isMatch);
      });
    }

    // 種目タブクリック
    discButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.dataset.discipline) {
          activeDisc = btn.dataset.discipline;
          updateView();
        }
      });
    });

    // カテゴリタブクリック
    catButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.dataset.category) {
          activeCat = btn.dataset.category;
          updateView();
        }
      });
    });

    updateView();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPointsTable);
  } else {
    setupPointsTable();
  }
  document.addEventListener('astro:page-load', setupPointsTable);
</script>