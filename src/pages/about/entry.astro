---
import Layout from '../../layouts/Layout.astro';
import { Content } from '../../content/entry.md';

const pageTitle = "エントリーガイド";
const pageDescription = "FWT（フリーライドワールドツアー）QualifierおよびJuniorの大会構造、参加資格、年齢カテゴリー、大会グレード（★レベル）と選手選考（シーディング）のルールを解説します。";
const ogImage = "/img/star_hero.webp";

// ページ固有の構造化データ（Schema.org）
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ItemPage",
    "name": pageTitle,
    "description": pageDescription,
    "image": ogImage,
    "mainEntity": {
      "@type": "Thing",
      "name": "FWT Qualifier / Junior エントリーガイド",
      "alternateName": ["FWT 大会グレード", "FWT シーディングルール", "FWT JAPAN SERIES 参加資格"],
      "description": "FWT QualifierおよびJuniorの大会構造、参加資格、大会グレード（1*〜4*）、シーディング選考に関する公式基準ガイド。"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "HOME",
        "item": "/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": pageTitle,
        "item": "/entry"
      }
    ]
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={ogImage}
  type="article"
  schema={schema}
>
  <!-- ヒーローセクション（LCP最適化・ツアープラットフォーム統一デザイン） -->
  <header class="relative w-full h-[280px] sm:h-[320px] md:h-[400px] overflow-hidden flex items-center justify-center text-center px-4">
    <div class="absolute inset-0">
      <img
        src={ogImage}
        alt="雪山を滑走するトップフリーライダーの競技シーン"
        class="w-full h-full object-cover scale-105 transform-gpu"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        width="1920"
        height="800"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/45 to-slate-950/90" aria-hidden="true"></div>
    </div>
    
    <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center">
      <span class="inline-block text-xs sm:text-sm font-black tracking-widest text-red-500 uppercase mb-3 px-3 py-1 bg-black/60 border border-red-500/30 rounded-full backdrop-blur-sm">
        QUALIFIER & JUNIOR GUIDE
      </span>
      <h1 class="font-extreme text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black text-white tracking-tighter uppercase m-0 leading-none drop-shadow-2xl">
        ENTRY
      </h1>
      <p class="mt-3 text-sm sm:text-base md:text-lg font-bold text-slate-200 tracking-wider">
        FWTピラミッドと大会参加要件
      </p>
    </div>
  </header>

  <!-- パンくずリストナビゲーション -->
  <nav aria-label="パンくずリスト" class="border-b border-slate-200 bg-slate-50/90">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 md:px-16 py-3">
      <ol class="flex items-center space-x-2 text-xs sm:text-sm text-slate-600">
        <li>
          <a
            href="/"
            class="hover:text-red-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded px-1 py-0.5 transition-colors"
          >
            HOME
          </a>
        </li>
        <li aria-hidden="true" class="text-slate-400 select-none">/</li>
        <li class="font-semibold text-slate-900 truncate" aria-current="page">
          {pageTitle}
        </li>
      </ol>
    </div>
  </nav>

  <!-- メインコンテンツセクション -->
  <main class="relative bg-white pt-12 md:pt-20 pb-24 md:pb-32 overflow-hidden border-b border-slate-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 md:px-16">
      <article
        class="prose prose-slate prose-lg md:prose-xl max-w-none
               prose-headings:font-black prose-headings:tracking-tight prose-headings:text-slate-900
               prose-h2:border-b border-slate-200 prose-h2:pb-4 prose-h2:mt-12 prose-h2:text-2xl md:prose-h2:text-3xl
               prose-h3:mt-8 prose-h3:text-xl md:prose-h3:text-2xl
               prose-a:text-red-600 prose-a:font-semibold prose-a:no-underline hover:prose-a:text-red-700 hover:prose-a:underline focus-visible:prose-a:outline-none focus-visible:prose-a:ring-2 focus-visible:prose-a:ring-red-500 rounded-sm
               prose-strong:text-slate-900 prose-strong:font-bold
               prose-img:mx-auto prose-img:rounded-2xl prose-img:shadow-xl
               prose-table:text-sm md:prose-table:text-base prose-th:bg-slate-100 prose-th:p-3 prose-td:p-3"
      >
        <Content />
      </article>
    </div>
  </main>
</Layout>