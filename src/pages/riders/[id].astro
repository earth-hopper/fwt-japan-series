---
import Layout from '../../layouts/Layout.astro';
import rawRiders from '../../data/riders.json';
import type { Rider } from '../../types/rider';

// ビルド時に生成するページのパスとPropsを定義
export async function getStaticPaths() {
  const riders = (rawRiders as Rider[]) || [];
  return riders.map((rider) => ({
    params: { id: rider.id },
    props: { rider },
  }));
}

interface Props {
  rider: Rider;
}

const { rider } = Astro.props;

// 大会ごとのポイント設定一覧
const events = [
  { name: 'Hakuba 4*', key: 'hakuba-q4' },
  { name: 'Arai 3*', key: 'arai-q3' },
  { name: 'Yuzawa Nakazato 2*', key: 'nakazato-q2' },
  { name: 'Yuzawa Nakazato 1*', key: 'nakazato-q1' },
  { name: 'Arai Junior 3*', key: 'arai-j3' },
  { name: 'Yuzawa Nakazato Junior 1*', key: 'nakazato-j1' },
];

// 種目の日本語マッピング
const disciplineMap: Record<string, string> = {
  'ALL': 'すべて',
  'SKI MEN': 'スキー男子',
  'SKI WOMEN': 'スキー女子',
  'SNOWBOARD MEN': 'スノーボード男子',
  'SNOWBOARD WOMEN': 'スノーボード女子'
};

const getDisciplineName = (disc: string): string => {
  if (!disc) return '';
  return disciplineMap[disc.toUpperCase()] || disc;
};

// 画像の有効性判定ヘルパー（_profile.webp等のプレースホルダーを弾く）
const isBlankImage = (path?: string): boolean => {
  if (!path || typeof path !== 'string') return true;
  const trimmed = path.trim();
  return trimmed === '' || trimmed === '/img/riders/default_profile.webp' || trimmed.endsWith('/no-image.webp') || (trimmed.includes('_profile.webp') && trimmed.length < 30);
};

const pageTitle = rider.rider;
const pageDescription = `${rider.rider}（${getDisciplineName(rider.discipline)} / ${rider.nation}）のFWT JAPAN SERIES 公式プロフィール、戦績、獲得ポイント詳細ページです。`;

// OGP画像（ライディング写真があれば優先、なければプロフィール写真、どちらもなければ共通OGP）
const heroImage = !isBlankImage(rider.riding) ? rider.riding : (!isBlankImage(rider.profile) ? rider.profile : '/img/riders.webp');
const ogImage = heroImage;

// --- JSON-LD (Person / BreadcrumbList) の生成 ---
const siteUrl = Astro.site?.toString() ?? "https://freerideworldtour.jp";
const canonicalRiderURL = new URL(Astro.url.pathname, siteUrl).toString();
const athleteImageURL = new URL(ogImage || '/img/og-main.jpg', siteUrl).toString();

const sameAsLinks: string[] = [];
if (rider.instagram) {
  sameAsLinks.push(`https://instagram.com/${rider.instagram.replace(/^@/, '')}`);
}

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "name": rider.rider,
    "description": pageDescription,
    "image": athleteImageURL,
    "url": canonicalRiderURL,
    "jobTitle": `${getDisciplineName(rider.discipline)} アスリート`,
    "nationality": rider.nation,
    "memberOf": {
      "@type": "SportsOrganization",
      "name": "FWT JAPAN SERIES",
      "url": siteUrl
    },
    ...(sameAsLinks.length > 0 ? { "sameAs": sameAsLinks } : {})
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "HOME",
        "item": "/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "ライダー",
        "item": "/riders/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": rider.rider,
        "item": canonicalRiderURL
      }
    ]
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={ogImage}
  type="article"
  schema={schema}
>
  <!-- ヒーローエリア（シャープなソリッドデザイン） -->
  <header class="relative w-full h-[420px] lg:h-[560px] bg-slate-950 overflow-hidden flex items-end">
    <div class="absolute inset-0">
      <img
        src={heroImage}
        alt={`${rider.rider} - Freeride World Tour Athlete`}
        class="w-full h-full object-cover opacity-80 object-top"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        width="1920"
        height="800"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/40 to-transparent" aria-hidden="true"></div>
    </div>

    <!-- ヒーロー内コンテンツ -->
    <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 md:px-16 pb-12 lg:pb-16">
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="text-xs font-bold font-mono tracking-widest bg-red-600 text-white px-3 py-1 uppercase">
          {getDisciplineName(rider.discipline)}
        </span>
        {rider.nation && (
          <span class="text-xs font-mono tracking-widest text-white border border-white/40 px-3 py-1 uppercase">
            {rider.nation}
          </span>
        )}
      </div>
      <h1 class="font-extreme text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black text-white tracking-tighter uppercase m-0 leading-none">
        {rider.rider}
      </h1>
    </div>
  </header>

  <!-- パンくずリストナビゲーション（ご指定のデザイン） -->
  <nav aria-label="パンくずリスト" class="border-b border-slate-200 bg-slate-50/90">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-16 py-3">
      <ol class="flex items-center space-x-2 text-xs sm:text-sm text-slate-600">
        <li>
          <a
            href="/"
            class="hover:text-red-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded px-1 py-0.5 transition-colors"
          >
            HOME
          </a>
        </li>
        <li aria-hidden="true" class="text-slate-400 select-none">/</li>
        <li>
          <a
            href="/riders/"
            class="hover:text-red-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded px-1 py-0.5 transition-colors"
          >
            ライダー
          </a>
        </li>
        <li aria-hidden="true" class="text-slate-400 select-none">/</li>
        <li class="font-semibold text-slate-900 truncate" aria-current="page">
          {rider.rider}
        </li>
      </ol>
    </div>
  </nav>

  <!-- メインコンテンツセクション -->
  <main class="py-16 md:py-24 bg-white">
    <article class="max-w-7xl mx-auto px-4 sm:px-6 md:px-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20">
        
        <!-- 左サイド：ポートレート & メタデータ -->
        <aside class="lg:col-span-4">
          <div class="lg:sticky lg:top-12">
            <!-- ポートレート写真（角丸・シャドウを廃したソリッドなフレーム） -->
            <figure class="aspect-[3/4] w-full bg-slate-100 mb-8 border-b-2 border-slate-900">
              {!isBlankImage(rider.profile) ? (
                <img
                  src={rider.profile}
                  alt={`${rider.rider}のプロフィール写真`}
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                  width="600"
                  height="800"
                />
              ) : (
                <div class="w-full h-full flex flex-col items-center justify-center text-slate-300" aria-hidden="true">
                  <svg class="w-16 h-16 mb-2 fill-current opacity-40" viewBox="0 0 24 24">
                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                  </svg>
                  <span class="text-[11px] font-mono tracking-widest uppercase">No Profile Image</span>
                </div>
              )}
            </figure>

            <!-- プロフィールスペック（クリーンな定義リスト） -->
            <dl class="space-y-6 m-0 p-0 border-b border-slate-200 pb-8">
              {rider.home && (
                <div>
                  <dt class="text-[10px] font-mono tracking-[0.25em] text-slate-400 uppercase font-bold mb-1">Home Mountain</dt>
                  <dd class="text-base sm:text-lg font-bold text-slate-900 m-0 tracking-tight">{rider.home}</dd>
                </div>
              )}
              {rider.instagram && (
                <div>
                  <dt class="text-[10px] font-mono tracking-[0.25em] text-slate-400 uppercase font-bold mb-1">Instagram</dt>
                  <dd class="m-0">
                    <a
                      href={`https://instagram.com/${rider.instagram.replace(/^@/, '')}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 text-base font-bold text-slate-900 hover:text-red-600 transition-colors group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500"
                    >
                      <svg class="w-4 h-4 text-slate-400 group-hover:text-red-600 transition-colors fill-current" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                      </svg>
                      <span class="border-b border-slate-900 group-hover:border-red-600 transition-colors pb-0.5">{rider.instagram}</span>
                    </a>
                  </dd>
                </div>
              )}
            </dl>
          </div>
        </aside>

        <!-- 右サイド：スタッツ & レコード -->
        <div class="lg:col-span-8">
          
          <!-- 1. SERIES POINTS（枠線を廃した大胆なエディトリアル・スコアボード） -->
          <section aria-labelledby="heading-points" class="mb-20">
            <div class="border-b border-slate-900 pb-3 mb-8 flex items-baseline justify-between">
              <h2 id="heading-points" class="font-mono text-xs tracking-[0.25em] uppercase font-bold text-slate-900 m-0">
                01 / Series Points
              </h2>
              <span class="text-[11px] font-mono text-slate-400 uppercase tracking-widest">Season Standing</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-end">
              <!-- トータルポイント（圧倒的なジャンプ率で配置） -->
              <div class="md:col-span-7">
                <span class="text-xs font-mono text-red-600 tracking-widest font-bold uppercase block mb-1">Total Series Points</span>
                <div class="text-7xl sm:text-8xl lg:text-9xl font-mono font-black text-slate-900 tracking-tighter leading-none">
                  {rider.point}
                </div>
              </div>

              <!-- 内訳（1st / 2nd Best） -->
              <div class="md:col-span-5 border-t md:border-t-0 md:border-l border-slate-200 pt-6 md:pt-0 md:pl-8">
                <div class="text-[10px] font-mono tracking-widest text-slate-400 uppercase font-bold mb-4">Calculation Breakdown</div>
                <div class="space-y-4">
                  <div class="flex items-baseline justify-between border-b border-slate-100 pb-2">
                    <span class="text-xs font-mono text-slate-500 uppercase tracking-wider">1st Best Score</span>
                    <span class="font-mono text-2xl font-black text-slate-900">{rider.best ?? '—'}</span>
                  </div>
                  <div class="flex items-baseline justify-between border-b border-slate-100 pb-2">
                    <span class="text-xs font-mono text-slate-500 uppercase tracking-wider">2nd Best Score</span>
                    <span class="font-mono text-2xl font-black text-slate-900">{rider.next ?? '—'}</span>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <!-- 2. EVENT BREAKDOWN（ミニマルなスイススタイル・テーブル） -->
          <section aria-labelledby="heading-breakdown" class="mb-20">
            <div class="border-b border-slate-900 pb-3 mb-6 flex items-baseline justify-between">
              <h2 id="heading-breakdown" class="font-mono text-xs tracking-[0.25em] uppercase font-bold text-slate-900 m-0">
                02 / Event Breakdown
              </h2>
              <span class="text-[11px] font-mono text-slate-400 uppercase tracking-widest">Points per Race</span>
            </div>

            <div class="w-full">
              <div class="grid grid-cols-[1fr_90px] sm:grid-cols-[1fr_140px] pb-3 border-b border-slate-300 font-mono text-[10px] font-bold text-slate-400 tracking-[0.2em] uppercase">
                <div>Event</div>
                <div class="text-right">Score</div>
              </div>
              <ul class="divide-y divide-slate-100 list-none p-0 m-0">
                {events.map((evt) => {
                  const rawScore = rider[evt.key as keyof Rider];
                  const score = Number(rawScore) || 0;
                  
                  return (
                    <li class="grid grid-cols-[1fr_90px] sm:grid-cols-[1fr_140px] items-center py-4 hover:pl-2 transition-all duration-200">
                      <span class="font-bold text-sm sm:text-base text-slate-900">{evt.name}</span>
                      <span class={`font-mono text-base sm:text-lg font-bold text-right ${score > 0 ? 'text-slate-900 font-black' : 'text-slate-300'}`}>
                        {score > 0 ? score.toLocaleString() : '—'}
                      </span>
                    </li>
                  );
                })}
              </ul>
            </div>
          </section>

          <!-- 3. TRACK RECORD -->
          {rider.results && (
            <section aria-labelledby="heading-results" class="mb-20">
              <div class="border-b border-slate-900 pb-3 mb-6">
                <h2 id="heading-results" class="font-mono text-xs tracking-[0.25em] uppercase font-bold text-slate-900 m-0">
                  03 / Track Record
                </h2>
              </div>
              <div class="text-slate-700 text-sm sm:text-base leading-relaxed whitespace-pre-line max-w-2xl font-normal">
                {rider.results}
              </div>
            </section>
          )}

          <!-- 4. RIDER COMMENT（グラデーションを排した洗練されたクォート） -->
          {rider.comment && (
            <section aria-labelledby="heading-comment" class="mb-12">
              <div class="border-b border-slate-900 pb-3 mb-8">
                <h2 id="heading-comment" class="font-mono text-xs tracking-[0.25em] uppercase font-bold text-slate-900 m-0">
                  04 / Rider Comment
                </h2>
              </div>
              <blockquote class="relative border-l-2 border-slate-900 pl-6 sm:pl-8 py-1 m-0">
                <p class="text-lg sm:text-xl lg:text-2xl font-medium text-slate-900 leading-relaxed italic whitespace-pre-line m-0">
                  “{rider.comment}”
                </p>
              </blockquote>
            </section>
          )}

        </div>
      </div>
    </article>
  </main>
</Layout>