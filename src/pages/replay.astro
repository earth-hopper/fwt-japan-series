---
import Layout from '../layouts/Layout.astro';

interface VideoItem {
  id: string;
  title: string;
  tag: string;
  duration: string;
  description?: string;
}

interface ShortVideoItem {
  id: string;
  title: string;
  location: string;
  label: string;
}

interface SnsLink {
  name: string;
  url: string;
  type: 'youtube' | 'instagram' | 'x';
}

const pageTitle = "リプレイ";
const pageDescription = "FWT JAPAN SERIESの大会映像アーカイブ＆ハイライト動画。雪山を滑走するトップライダーたちのライディング映像やウィニングラン、ドローン空撮による迫力の競技シーンを動画でご覧いただけます。";
const ogImage = "/img/replay.webp";

// サイトURLと絶対URLの組み立て
const siteUrl = Astro.site?.toString() ?? 'https://freerideworldtour.jp';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();

// 1. 動画アセット定義
const highlightVideo: VideoItem = {
  id: "uNCjkYOD-XM",
  title: "2026 HAKUBA COMPETITION - 30MIN FULL HIGHLIGHT",
  tag: "FEATURED HIGHLIGHT",
  duration: "30:45",
  description: "FWT JAPAN SERIES 2026 白馬大会の30分フルハイライト。自然の雪山を攻めるトップライダーたちの迫力のライディングとウィニングランを完全収録。"
};

const teaserVideo: VideoItem = {
  id: "_u5_w-vXMxo",
  title: "FWT JAPAN SERIES 2026 OFFICIAL TEASER",
  tag: "OFFICIAL TRAILER",
  duration: "01:30",
  description: "世界最高峰のフリーライドツアープラットフォーム「FWT JAPAN SERIES 2026」の公式ティザートレーラー映像。"
};

const shortVideos: ShortVideoItem[] = [
  {
    id: "wMIdkFYESGw",
    title: "CLIFF DROP IN DEEP POWDER",
    location: "HAKUBA",
    label: "CLIP 01"
  },
  {
    id: "BH5P-JdAx5M",
    title: "TECHNICAL TREE & SPEED RUN",
    location: "NAKAZATO",
    label: "CLIP 02"
  },
  {
    id: "CECGaYiplbw",
    title: "MASSIVE AIR & PILLOW LINE",
    location: "ARAI",
    label: "CLIP 03"
  }
];

// 2. SNSリンク定義
const snsLinks: SnsLink[] = [
  {
    name: "YouTube",
    url: "https://www.youtube.com/@FreerideWorldTourJapan",
    type: "youtube"
  },
  {
    name: "Instagram",
    url: "https://www.instagram.com/freerideworldtour_jp/",
    type: "instagram"
  },
  {
    name: "X (Twitter)",
    url: "https://x.com/fwt_japan",
    type: "x"
  }
];

// ページ固有の構造化データ（Schema.org: CollectionPage + VideoObject + BreadcrumbList）
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": pageTitle,
    "description": pageDescription,
    "url": pageUrl,
    "hasPart": [
      {
        "@type": "VideoObject",
        "name": highlightVideo.title,
        "description": highlightVideo.description,
        "thumbnailUrl": `https://img.youtube.com/vi/${highlightVideo.id}/maxresdefault.jpg`,
        "embedUrl": `https://www.youtube.com/embed/${highlightVideo.id}`,
        "uploadDate": "2026-01-01T00:00:00+09:00"
      },
      {
        "@type": "VideoObject",
        "name": teaserVideo.title,
        "description": teaserVideo.description,
        "thumbnailUrl": `https://img.youtube.com/vi/${teaserVideo.id}/maxresdefault.jpg`,
        "embedUrl": `https://www.youtube.com/embed/${teaserVideo.id}`,
        "uploadDate": "2026-01-01T00:00:00+09:00"
      }
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "HOME",
        "item": "/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": pageTitle,
        "item": "/replay/"
      }
    ]
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={ogImage}
  type="website"
  schema={schema}
>
  <!-- ヒーローセクション（LCP改善・ブランド統一デザイン） -->
  <header class="relative w-full h-[280px] sm:h-[320px] md:h-[400px] overflow-hidden flex items-center justify-center text-center px-4">
    <div class="absolute inset-0">
      <img
        src={ogImage}
        alt="雪山をダイナミックに滑走するフリーライド競技の大会映像"
        class="w-full h-full object-cover scale-105 transform-gpu"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        width="1920"
        height="800"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/45 to-slate-950/90" aria-hidden="true"></div>
    </div>
    
    <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center">
      <span class="inline-block text-xs sm:text-sm font-black tracking-widest text-red-500 uppercase mb-3 px-3 py-1 bg-black/60 border border-red-500/30 rounded-full backdrop-blur-sm">
        Official Video Archives
      </span>
      <h1 class="font-extreme text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-black text-white tracking-tighter uppercase m-0 leading-none drop-shadow-2xl">
        REPLAY
      </h1>
      <p class="mt-3 text-sm sm:text-base md:text-lg font-bold text-slate-200 tracking-wider">
        大会公式映像・ハイライト＆リプレイ
      </p>
    </div>
  </header>

  <!-- パンくずリストナビゲーション -->
  <nav aria-label="パンくずリスト" class="border-b border-slate-200 bg-slate-50/90">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-16 py-3">
      <ol class="flex items-center space-x-2 text-xs sm:text-sm text-slate-600">
        <li>
          <a
            href="/"
            class="hover:text-red-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded px-1 py-0.5 transition-colors"
          >
            HOME
          </a>
        </li>
        <li aria-hidden="true" class="text-slate-400 select-none">/</li>
        <li class="font-semibold text-slate-900 truncate" aria-current="page">
          {pageTitle}
        </li>
      </ol>
    </div>
  </nav>

  <!-- メイン動画セクション -->
  <main class="relative bg-white pt-10 md:pt-16 pb-24 md:pb-32 overflow-hidden border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-16">

      <!-- 1. 30MIN HIGHLIGHT -->
      <section aria-labelledby="heading-highlight" class="mb-16 md:mb-24">
        <div class="flex items-end justify-between pb-3 border-b-2 border-slate-900 mb-6">
          <div>
            <div class="flex items-center gap-2 mb-1.5">
              <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse" aria-hidden="true"></span>
              <span class="font-mono text-[10px] md:text-xs font-bold text-red-600 tracking-[0.3em] uppercase">
                {highlightVideo.tag}
              </span>
            </div>
            <h2 id="heading-highlight" class="font-extreme text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tighter uppercase m-0 leading-none">
              30MIN HIGHLIGHT
            </h2>
          </div>
          <span class="font-mono text-xs md:text-sm font-bold text-slate-500 tracking-wider">
            {highlightVideo.duration}
          </span>
        </div>

        <!-- 16:9 動画コンテナ（Tailwindユーティリティによる完全レスポンシブ化） -->
        <div class="video-container relative w-full aspect-video bg-slate-950 rounded-2xl overflow-hidden border border-slate-200 shadow-lg">
          <button
            type="button"
            class="video-facade group absolute inset-0 w-full h-full block text-left cursor-pointer focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-red-500 focus-visible:ring-inset"
            data-video-id={highlightVideo.id}
            data-video-title={highlightVideo.title}
            aria-label={`動画を再生: ${highlightVideo.title}`}
          >
            <img 
              src={`https://img.youtube.com/vi/${highlightVideo.id}/maxresdefault.jpg`} 
              alt={highlightVideo.title}
              loading="eager"
              decoding="async"
              fetchpriority="high"
              width="1280"
              height="720"
              class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500 ease-out"
            />
            <div class="absolute inset-0 bg-black/30 group-hover:bg-black/15 transition-colors" aria-hidden="true"></div>
            
            <!-- 中央再生ボタン -->
            <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
              <div class="w-16 h-16 md:w-20 md:h-20 bg-red-600 text-white rounded-full flex items-center justify-center shadow-2xl group-hover:scale-110 group-hover:bg-red-700 transition-all duration-300">
                <svg class="w-8 h-8 md:w-10 md:h-10 fill-current translate-x-0.5" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
            </div>
          </button>
        </div>
      </section>

      <!-- 2. OFFICIAL TEASER -->
      <section aria-labelledby="heading-teaser" class="mb-16 md:mb-24">
        <div class="flex items-end justify-between pb-3 border-b-2 border-slate-900 mb-6">
          <div>
            <div class="flex items-center gap-2 mb-1.5">
              <span class="w-2 h-2 rounded-full bg-red-600" aria-hidden="true"></span>
              <span class="font-mono text-[10px] md:text-xs font-bold text-red-600 tracking-[0.3em] uppercase">
                {teaserVideo.tag}
              </span>
            </div>
            <h2 id="heading-teaser" class="font-extreme text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tighter uppercase m-0 leading-none">
              OFFICIAL TEASER
            </h2>
          </div>
          <span class="font-mono text-xs md:text-sm font-bold text-slate-500 tracking-wider">
            {teaserVideo.duration}
          </span>
        </div>

        <div class="video-container relative w-full aspect-video bg-slate-950 rounded-2xl overflow-hidden border border-slate-200 shadow-md">
          <button
            type="button"
            class="video-facade group absolute inset-0 w-full h-full block text-left cursor-pointer focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-red-500 focus-visible:ring-inset"
            data-video-id={teaserVideo.id}
            data-video-title={teaserVideo.title}
            aria-label={`動画を再生: ${teaserVideo.title}`}
          >
            <img 
              src={`https://img.youtube.com/vi/${teaserVideo.id}/maxresdefault.jpg`} 
              alt={teaserVideo.title}
              loading="lazy"
              decoding="async"
              width="1280"
              height="720"
              class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500 ease-out"
            />
            <div class="absolute inset-0 bg-black/30 group-hover:bg-black/15 transition-colors" aria-hidden="true"></div>

            <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
              <div class="w-14 h-14 md:w-16 md:h-16 bg-white/95 text-slate-900 rounded-full flex items-center justify-center shadow-xl group-hover:bg-red-600 group-hover:text-white group-hover:scale-110 transition-all duration-300">
                <svg class="w-6 h-6 md:w-8 md:h-8 fill-current translate-x-0.5" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </div>
            </div>
          </button>
        </div>
      </section>

      <!-- 3. SHORTS (9:16) -->
      <section aria-labelledby="heading-shorts" class="mb-16 md:mb-24">
        <div class="flex items-end justify-between pb-3 border-b-2 border-slate-900 mb-6">
          <div>
            <div class="flex items-center gap-2 mb-1.5">
              <span class="w-2 h-2 rounded-full bg-red-600" aria-hidden="true"></span>
              <span class="font-mono text-[10px] md:text-xs font-bold text-red-600 tracking-[0.3em] uppercase">
                QUICK ACTION
              </span>
            </div>
            <h2 id="heading-shorts" class="font-extreme text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tighter uppercase m-0 leading-none">
              SHORTS
            </h2>
          </div>
          <span class="font-mono text-xs md:text-sm font-bold text-slate-400 tracking-wider">
            9:16 VERTICAL
          </span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          {shortVideos.map((short) => (
            <div class="flex flex-col">
              <div class="video-container relative w-full aspect-[9/16] bg-slate-950 rounded-2xl overflow-hidden border border-slate-200 shadow-md">
                <button
                  type="button"
                  class="video-facade group absolute inset-0 w-full h-full block text-left cursor-pointer focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-red-500 focus-visible:ring-inset"
                  data-video-id={short.id}
                  data-video-title={short.title}
                  aria-label={`ショート動画を再生: ${short.title}`}
                >
                  <img 
                    src={`https://img.youtube.com/vi/${short.id}/hqdefault.jpg`} 
                    alt={short.title}
                    loading="lazy"
                    decoding="async"
                    width="480"
                    height="854"
                    class="absolute inset-0 w-full h-full object-cover opacity-85 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500 ease-out"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-black/25" aria-hidden="true"></div>

                  <div class="absolute top-3.5 right-3.5 z-10 pointer-events-none">
                    <span class="font-mono text-[10px] bg-red-600 text-white px-2.5 py-0.5 rounded-full tracking-wider font-bold shadow-sm">
                      SHORTS
                    </span>
                  </div>

                  <div class="absolute inset-0 flex items-center justify-center" aria-hidden="true">
                    <div class="w-12 h-12 bg-white/95 text-slate-900 rounded-full flex items-center justify-center shadow-xl group-hover:bg-red-600 group-hover:text-white group-hover:scale-110 transition-all duration-300">
                      <svg class="w-6 h-6 fill-current translate-x-0.5" viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z" />
                      </svg>
                    </div>
                  </div>

                  <div class="absolute bottom-4 left-4 right-4 z-10 pointer-events-none">
                    <span class="text-[10px] font-mono text-slate-300 tracking-wider block mb-1">
                      {short.location}
                    </span>
                    <p class="text-white font-bold text-sm leading-snug group-hover:text-red-400 transition-colors line-clamp-2 m-0">
                      {short.title}
                    </p>
                  </div>
                </button>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 4. OFFICIAL SNS BUTTONS -->
      <section aria-label="公式ソーシャルメディアリンク" class="flex flex-wrap items-center justify-center gap-3 pt-10 border-t border-slate-200">
        {snsLinks.map((sns) => (
          <a
            href={sns.url}
            target="_blank"
            rel="noopener noreferrer"
            class="px-5 py-2.5 text-xs md:text-sm font-bold tracking-wider border rounded-full transition-all duration-300 outline-none bg-white text-slate-600 border-slate-200 hover:border-slate-900 hover:text-white hover:bg-slate-900 inline-flex items-center gap-2.5 focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2"
          >
            {sns.type === 'youtube' && (
              <svg class="w-4 h-4 fill-current text-red-600" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.376.55 9.376.55s7.505 0 9.377-.55a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            )}
            {sns.type === 'instagram' && (
              <svg class="w-4 h-4 fill-currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            )}
            {sns.type === 'x' && (
              <svg class="w-3.5 h-3.5 fill-currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            )}
            <span>{sns.name}</span>
          </a>
        ))}
      </section>

    </div>
  </main>
</Layout>

<script>
  function setupVideoPlayers() {
    const facades = document.querySelectorAll<HTMLButtonElement>('.video-facade');

    facades.forEach((facade) => {
      facade.onclick = () => {
        const videoId = facade.getAttribute('data-video-id');
        const videoTitle = facade.getAttribute('data-video-title') || 'YouTube video player';
        const container = facade.parentElement;
        if (!videoId || !container) return;

        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube.com/embed/${encodeURIComponent(videoId)}?autoplay=1&rel=0`;
        iframe.title = videoTitle;
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.className = 'absolute inset-0 w-full h-full border-0';

        container.replaceChildren(iframe);
      };
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupVideoPlayers);
  } else {
    setupVideoPlayers();
  }
  document.addEventListener('astro:page-load', setupVideoPlayers);
</script>