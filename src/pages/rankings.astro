---
import Layout from '../layouts/Layout.astro';
import rawRiders from '../data/riders.json';
import type { Rider } from '../types/rider';

const pageTitle = "FWT JAPAN RANKING";
const pageDescription = "FWT JAPAN RANKINGの公式最新ランキング。フリーライドスキー・スノーボード男女各ディビジョン別獲得ポイントや順位をリアルタイム配信。トップライダーの戦況をお届けします。";
const ogImage = "/img/rankings_hero.webp";

// サイトURLと絶対URLの組み立て
const siteUrl = Astro.site?.toString() ?? 'https://freerideworldtour.jp';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();

// 種目の日本語マッピング
const disciplineMap: Record<string, string> = {
  'ALL': 'すべて',
  'SKI MEN': 'スキー男子',
  'SKI WOMEN': 'スキー女子',
  'SNOWBOARD MEN': 'スノーボード男子',
  'SNOWBOARD WOMEN': 'スノーボード女子'
};

const getDisciplineName = (disc: string): string => {
  if (!disc) return '';
  return disciplineMap[disc.toUpperCase()] || disc;
};

// プロフィール画像ブランク判定
const isBlankProfile = (path?: string): boolean => {
  if (!path || typeof path !== 'string') return true;
  const trimmed = path.trim();
  return trimmed === '' || trimmed === '/img/riders/default_profile.webp' || trimmed.endsWith('/no-image.webp');
};

const riders = (rawRiders as Rider[]) || [];

// 1. 種目一覧を取得・ソート
const disciplines = [...new Set(riders.map((r) => r.discipline).filter(Boolean))].sort();

// 2. 種目ごとにフィルタリング＆獲得ポイント降順で事前ソート
const rankingsByDiscipline = disciplines.reduce<Record<string, Rider[]>>((acc, disc) => {
  acc[disc] = riders
    .filter((r) => r.discipline === disc)
    .sort((a, b) => (Number(b.point) || 0) - (Number(a.point) || 0));
  return acc;
}, {});

// ページ固有の構造化データ（Schema.org: CollectionPage + BreadcrumbList）
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": pageTitle,
    "description": pageDescription,
    "url": pageUrl
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "HOME",
        "item": "/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": pageTitle,
        "item": "/rankings/"
      }
    ]
  }
];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={ogImage}
  type="website"
  schema={schema}
>
  <!-- ヒーローセクション（LCP最適化・ツアープラットフォーム統一デザイン） -->
  <header class="relative w-full h-[280px] sm:h-[320px] md:h-[400px] overflow-hidden flex items-center justify-center text-center px-4">
    <div class="absolute inset-0">
      <img
        src={ogImage}
        alt="雪山を滑走するトップフリーライダーの競技シーン"
        class="w-full h-full object-cover scale-105 transform-gpu"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        width="1920"
        height="800"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/75 via-black/45 to-slate-950/90" aria-hidden="true"></div>
    </div>
    
    <div class="relative z-10 max-w-4xl mx-auto flex flex-col items-center">
      <span class="inline-block text-xs sm:text-sm font-black tracking-widest text-red-500 uppercase mb-3 px-3 py-1 bg-black/60 border border-red-500/30 rounded-full backdrop-blur-sm">
        Official Standings
      </span>
      <h1 class="font-extreme text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-black text-white tracking-tighter uppercase m-0 leading-none drop-shadow-2xl">
        RANKING
      </h1>
      <p class="mt-3 text-sm sm:text-base md:text-lg font-bold text-slate-200 tracking-wider">
        FWT JAPAN RANKING 公式順位表
      </p>
    </div>
  </header>

  <!-- パンくずリストナビゲーション -->
  <nav aria-label="パンくずリスト" class="border-b border-slate-200 bg-slate-50/90">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-16 py-3">
      <ol class="flex items-center space-x-2 text-xs sm:text-sm text-slate-600">
        <li>
          <a
            href="/"
            class="hover:text-red-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 rounded px-1 py-0.5 transition-colors"
          >
            HOME
          </a>
        </li>
        <li aria-hidden="true" class="text-slate-400 select-none">/</li>
        <li class="font-semibold text-slate-900 truncate" aria-current="page">
          {pageTitle}
        </li>
      </ol>
    </div>
  </nav>

  <!-- ランキング本体セクション -->
  <main class="relative bg-white pt-10 md:pt-16 pb-24 md:pb-32 overflow-hidden border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-16">
      
      <!-- カテゴリ切り替えボタン（WAI-ARIA対応タブリスト） -->
      <section aria-label="ディビジョン切り替え" class="mb-10 md:mb-12">
        <div id="division-buttons" role="tablist" class="flex flex-wrap gap-2.5 sm:gap-3">
          {disciplines.map((disc, index) => {
            const tabId = `tab-${disc.toLowerCase().replace(/\s+/g, '-')}`;
            const panelId = `panel-${disc.toLowerCase().replace(/\s+/g, '-')}`;
            return (
              <button
                type="button"
                role="tab"
                id={tabId}
                aria-controls={panelId}
                aria-selected={index === 0 ? 'true' : 'false'}
                data-discipline={disc}
                class="tab-btn px-4 sm:px-5 py-2 sm:py-2.5 text-xs md:text-sm font-bold tracking-wider border rounded-full transition-all duration-200 outline-none
                       bg-white text-slate-600 border-slate-200 hover:border-slate-400 hover:text-slate-900
                       aria-selected:bg-slate-900 aria-selected:text-white aria-selected:border-slate-900 aria-selected:shadow-md
                       focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-offset-2"
              >
                {getDisciplineName(disc)}
              </button>
            );
          })}
        </div>
      </section>

      <!-- ランキングテーブル -->
      <div class="w-full border-t-2 border-slate-900">
        <!-- デスクトップ用テーブルヘッダー -->
        <div class="hidden md:grid grid-cols-[80px_1fr_120px_120px_130px] border-b border-slate-900 bg-white">
          <div class="px-6 py-4 font-mono text-[10px] font-bold text-slate-400 tracking-[0.3em] uppercase">Rank</div>
          <div class="px-6 py-4 font-mono text-[10px] font-bold text-slate-400 tracking-[0.3em] uppercase">Rider</div>
          <div class="px-6 py-4 font-mono text-[10px] font-bold text-slate-400 tracking-[0.3em] uppercase text-right">1st</div>
          <div class="px-6 py-4 font-mono text-[10px] font-bold text-slate-400 tracking-[0.3em] uppercase text-right">2nd</div>
          <div class="px-6 py-4 font-mono text-[10px] font-bold text-red-600 tracking-[0.3em] uppercase text-right pr-12">Total Point</div>
        </div>

        <!-- 各種目のランキングリスト -->
        <div id="rankings-wrapper">
          {disciplines.map((disc, discIndex) => {
            const riderList = rankingsByDiscipline[disc] || [];
            const tabId = `tab-${disc.toLowerCase().replace(/\s+/g, '-')}`;
            const panelId = `panel-${disc.toLowerCase().replace(/\s+/g, '-')}`;

            return (
              <div
                id={panelId}
                role="tabpanel"
                aria-labelledby={tabId}
                data-content-discipline={disc}
                class={`discipline-content divide-y divide-slate-100 bg-white ${discIndex === 0 ? '' : 'hidden'}`}
              >
                {riderList.length === 0 ? (
                  <div class="p-12 text-center text-slate-500 text-sm font-medium">該当するデータがありません。</div>
                ) : (
                  riderList.map((rider, index) => {
                    const rank = index + 1;
                    return (
                      <a
                        href={`/riders/${rider.id}/`}
                        class="group block relative transition-colors duration-200 hover:bg-slate-50/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500 focus-visible:ring-inset"
                      >
                        <!-- モバイルビュー -->
                        <div class="md:hidden p-5 sm:p-6 border-b border-slate-100 group-last:border-0">
                          <div class="flex items-center justify-between mb-3 gap-3">
                            <div class="flex items-center gap-3 min-w-0">
                              <span class={`font-mono text-sm font-black w-7 flex-shrink-0 ${
                                rank === 1 ? 'text-amber-500' : rank === 2 ? 'text-slate-500' : rank === 3 ? 'text-amber-700' : 'text-slate-400'
                              }`}>
                                #{rank}
                              </span>
                              
                              <!-- アイコン表示 (Mobile) -->
                              {!isBlankProfile(rider.profile) ? (
                                <img
                                  src={rider.profile}
                                  alt={rider.rider}
                                  loading="lazy"
                                  decoding="async"
                                  width="40"
                                  height="40"
                                  class="w-10 h-10 rounded-full object-cover border border-slate-200 flex-shrink-0 shadow-sm"
                                />
                              ) : (
                                <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center border border-slate-200 flex-shrink-0 text-slate-400" aria-hidden="true">
                                  <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                  </svg>
                                </div>
                              )}
                              
                              <div class="flex flex-col items-start gap-0.5 min-w-0">
                                <span class="font-extreme text-sm sm:text-base font-black text-slate-900 uppercase group-hover:text-red-600 transition-colors leading-tight truncate">
                                  {rider.rider}
                                </span>
                                <span class="text-[9px] font-mono text-slate-500 bg-slate-100 px-1.5 py-0.5 rounded border border-slate-200">
                                  {rider.nation || '---'}
                                </span>
                              </div>
                            </div>
                            <span class="font-mono text-lg font-black text-red-600 flex-shrink-0">
                              {rider.point}
                            </span>
                          </div>
                          
                          <div class="flex justify-between items-center text-[10px] text-slate-400 font-mono tracking-wider pl-10 ml-7">
                            <div class="flex gap-4">
                              <span>1st: <strong class="text-slate-700 font-bold ml-1">{rider.best ?? '-'}</strong></span>
                              <span>2nd: <strong class="text-slate-700 font-bold ml-1">{rider.next ?? '-'}</strong></span>
                            </div>
                            <svg class="w-4 h-4 text-slate-300 group-hover:text-red-600 group-hover:translate-x-0.5 transition-all duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                              <line x1="5" y1="12" x2="19" y2="12"></line>
                              <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                          </div>
                        </div>

                        <!-- デスクトップビュー -->
                        <div class="hidden md:grid grid-cols-[80px_1fr_120px_120px_130px] items-center border-b border-slate-100 group-last:border-0 relative">
                          <div class={`px-6 py-5 font-mono text-base font-black ${
                            rank === 1 ? 'text-amber-500' : rank === 2 ? 'text-slate-500' : rank === 3 ? 'text-amber-700' : 'text-slate-400'
                          }`}>
                            #{rank}
                          </div>
                          
                          <div class="px-6 py-5 flex items-center gap-4 min-w-0">
                            <!-- アイコン表示 (Desktop) -->
                            {!isBlankProfile(rider.profile) ? (
                              <img
                                src={rider.profile}
                                alt={rider.rider}
                                loading="lazy"
                                decoding="async"
                                width="48"
                                height="48"
                                class="w-12 h-12 rounded-full object-cover border border-slate-200 flex-shrink-0 shadow-sm"
                              />
                            ) : (
                              <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center border border-slate-200 flex-shrink-0 text-slate-400" aria-hidden="true">
                                <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
                                  <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                </svg>
                              </div>
                            )}
                            
                            <div class="flex items-center gap-3 min-w-0">
                              <span class="font-extreme text-lg font-black text-slate-900 uppercase group-hover:text-red-600 transition-colors truncate">
                                {rider.rider}
                              </span>
                              <span class="text-[10px] font-mono text-slate-500 bg-slate-100 px-2 py-0.5 rounded border border-slate-200 uppercase flex-shrink-0">
                                {rider.nation || '---'}
                              </span>
                            </div>
                          </div>
                          
                          <div class="px-6 py-5 font-mono text-sm text-slate-600 text-right font-medium">{rider.best ?? '-'}</div>
                          <div class="px-6 py-5 font-mono text-sm text-slate-600 text-right font-medium">{rider.next ?? '-'}</div>
                          <div class="px-6 py-5 font-mono text-xl font-black text-red-600 text-right pr-12">{rider.point}</div>
                          
                          <div class="absolute right-6 opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all duration-300 text-red-600" aria-hidden="true">
                            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                              <line x1="5" y1="12" x2="19" y2="12"></line>
                              <polyline points="12 5 19 12 12 19"></polyline>
                            </svg>
                          </div>
                        </div>
                      </a>
                    );
                  })
                )}
              </div>
            );
          })}
        </div>
      </div>

      <!-- FWT JAPAN RANKING レギュレーション解説セクション（エディトリアルデザイン） -->
      <section aria-labelledby="ranking-system-title" class="mt-16 md:mt-24">
        <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-slate-900 via-slate-900 to-slate-950 p-8 sm:p-10 md:p-12 text-white shadow-xl border border-slate-800">
          <div class="absolute top-0 right-0 -mt-12 -mr-12 w-96 h-96 bg-red-600/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
          
          <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            <div class="lg:col-span-7">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/10 border border-red-500/20 text-red-400 font-mono text-xs font-bold tracking-wider uppercase mb-4">
                System & Regulation
              </div>
              <h2 id="ranking-system-title" class="font-extreme text-2xl sm:text-3xl md:text-4xl font-black tracking-tight uppercase leading-tight mb-4 text-white">
                FWT JAPAN RANKINGの仕組み
              </h2>
              <p class="text-slate-300 text-sm sm:text-base leading-relaxed mb-6 font-normal">
                FWT JAPAN RANKINGは、FWT JAPAN SERIES各大会で選手が獲得したポイントのうち、最も高いスコア（<span class="text-white font-bold font-mono">1st</span>）と2番目に高いスコア（<span class="text-white font-bold font-mono">2nd</span>）の上位2戦分を合算して算出されます。
              </p>

              <!-- ポイント合算フォーミュラ -->
              <div class="grid grid-cols-3 gap-3 max-w-md p-3.5 bg-slate-800/60 rounded-xl border border-slate-700/60 text-center font-mono">
                <div class="flex flex-col items-center">
                  <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">Top Score</span>
                  <span class="text-sm sm:text-base font-black text-red-400 mt-0.5">1st BEST</span>
                </div>
                <div class="flex items-center justify-center text-slate-400 text-lg font-bold" aria-hidden="true">+</div>
                <div class="flex flex-col items-center">
                  <span class="text-[10px] text-slate-400 font-bold uppercase tracking-wider">2nd Score</span>
                  <span class="text-sm sm:text-base font-black text-slate-200 mt-0.5">2nd BEST</span>
                </div>
              </div>
            </div>

            <div class="lg:col-span-5 flex flex-col justify-center items-start lg:items-end lg:border-l lg:border-slate-800 lg:pl-10">
              <span class="font-mono text-xs uppercase tracking-widest text-slate-400 mb-2">Global Standings</span>
              <p class="text-slate-400 text-xs sm:text-sm leading-relaxed mb-6 lg:text-right">
                世界各国の予選シリーズを統合したFWTグローバルランキングはこちらから確認できます。
              </p>
              <a
                href="https://www.freerideworldtour.com/qualifier/rankings/"
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-2.5 px-6 py-3.5 text-xs sm:text-sm font-bold tracking-wider uppercase text-white bg-red-600 hover:bg-red-700 rounded-full transition-all duration-300 shadow-lg shadow-red-600/20 hover:shadow-red-600/40 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-400 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-900"
              >
                <span>FWT Global Rankings</span>
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="7" y1="17" x2="17" y2="7"></line>
                  <polyline points="7 7 17 7 17 17"></polyline>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </section>
      
    </div>
  </main>
</Layout>

<script>
  function setupRankings() {
    const tabContainer = document.getElementById('division-buttons');
    const contents = document.querySelectorAll<HTMLElement>('.discipline-content');

    if (!tabContainer || contents.length === 0) return;

    const buttons = tabContainer.querySelectorAll<HTMLButtonElement>('.tab-btn');

    const urlParams = new URLSearchParams(window.location.search);
    const urlDiscipline = urlParams.get('discipline');
    const storageDiscipline = sessionStorage.getItem('fwt_selected_discipline');

    const availableDisciplines = Array.from(buttons).map((btn) => btn.dataset.discipline);
    const initialDiscipline =
      urlDiscipline && availableDisciplines.includes(urlDiscipline)
        ? urlDiscipline
        : storageDiscipline && availableDisciplines.includes(storageDiscipline)
        ? storageDiscipline
        : availableDisciplines[0] || '';

    function switchDiscipline(targetDiscipline: string) {
      sessionStorage.setItem('fwt_selected_discipline', targetDiscipline);
      const newUrl = new URL(window.location.href);
      newUrl.searchParams.set('discipline', targetDiscipline);
      window.history.replaceState({}, '', newUrl);

      // ARIA 属性を更新（Tailwind の aria-selected バリアントでスタイル連動）
      buttons.forEach((btn) => {
        const isActive = btn.dataset.discipline === targetDiscipline;
        btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      // タブパネルの表示切り替え
      contents.forEach((content) => {
        const isMatch = content.dataset.contentDiscipline === targetDiscipline;
        content.classList.toggle('hidden', !isMatch);
      });
    }

    // イベント委譲によるタブ切り替え
    tabContainer.onclick = (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.tab-btn');
      if (btn && btn.dataset.discipline) {
        switchDiscipline(btn.dataset.discipline);
      }
    };

    switchDiscipline(initialDiscipline);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupRankings);
  } else {
    setupRankings();
  }
  document.addEventListener('astro:page-load', setupRankings);
</script>